function addMarksheetSubject(subjectName,total,obtained){
  const container=document.getElementById('msSubjectsContainer');
  const index=subjectRows.length;
  const row=document.createElement('div');
  row.className='marksheet-subject-row';
  row.id='msRow_'+index;
  row.innerHTML=`
    <input type="text" class="subject-name-input ms-subject" data-index="${index}" placeholder="Enter subject name" value="${subjectName||'Subject '+(index+1)}" oninput="updateMarksheetTotals()" />
    <input type="number" class="ms-total" data-index="${index}" value="${total||100}" oninput="updateMarksheetTotals()" />
    <input type="number" class="ms-obtained" data-index="${index}" value="${obtained||0}" oninput="updateMarksheetTotals()" />
    <button class="btn btn-danger btn-xs" onclick="removeMarksheetSubject(${index})">✕</button>
  `;
  container.appendChild(row);
  subjectRows.push({subject:subjectName||'Subject '+(index+1),total:total||100,obtained:obtained||0});
  updateMarksheetTotals();
}

function removeMarksheetSubject(index){
  const row=document.getElementById('msRow_'+index);
  if(row){row.remove();subjectRows.splice(index,1);updateMarksheetTotals();}
}

function updateMarksheetTotals(){
  let totalMarks=0,obtainedMarks=0;
  document.querySelectorAll('.ms-total').forEach(el=>{totalMarks+=parseFloat(el.value)||0;});
  document.querySelectorAll('.ms-obtained').forEach(el=>{obtainedMarks+=parseFloat(el.value)||0;});
  document.getElementById('msTotalMarks').value=totalMarks;
  document.getElementById('msObtainedMarks').value=obtainedMarks;
  const percentage=totalMarks>0?((obtainedMarks/totalMarks)*100):0;
  document.getElementById('msPercentage').value=percentage.toFixed(1)+'%';
  document.getElementById('msGrade').value=getGrade(percentage);
  document.querySelectorAll('.ms-subject').forEach(el=>{
    const idx=parseInt(el.dataset.index);
    if(subjectRows[idx]){subjectRows[idx].subject=el.value;}
  });
  document.querySelectorAll('.ms-total').forEach(el=>{
    const idx=parseInt(el.dataset.index);
    if(subjectRows[idx]){subjectRows[idx].total=parseFloat(el.value)||0;}
  });
  document.querySelectorAll('.ms-obtained').forEach(el=>{
    const idx=parseInt(el.dataset.index);
    if(subjectRows[idx]){subjectRows[idx].obtained=parseFloat(el.value)||0;}
  });
}

