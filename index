function addCustomClass(){
  const name=document.getElementById('newClassName').value.trim();
  if(!name){showToast('⚠️ Enter class name!','error');return;}
  const settings=AppData.schoolSettings;
  if(settings.classes.includes(name)){showToast('⚠️ Class already exists!','error');return;}
  settings.classes.push(name);
  if(!settings.subjects[name]) settings.subjects[name]=['English','Urdu','Math'];
  saveToStorage();
  renderSettings();
  showToast(`✅ Class "${name}" added!`,'success');
}

function deleteCustomClass(className){
  if(!confirm(`Delete class "${className}"? Students in this class will not be affected.`)) return;
  const settings=AppData.schoolSettings;
  settings.classes=settings.classes.filter(c=>c!==className);
  delete settings.subjects[className];
  saveToStorage();
  renderSettings();
  showToast(`🗑️ Class "${className}" deleted!`,'info');
}

function addSubjectToClass(className){
  const inputId='newSubject_'+className.replace(/\s/g,'_');
  const input=document.getElementById(inputId);
  if(!input) return;
  const subject=input.value.trim();
  if(!subject){showToast('⚠️ Enter subject name!','error');return;}
  const settings=AppData.schoolSettings;
  if(!settings.subjects[className]) settings.subjects[className]=[];
  if(settings.subjects[className].includes(subject)){showToast('⚠️ Subject already exists!','error');return;}
  settings.subjects[className].push(subject);
  saveToStorage();
  renderSettings();
  showToast(`✅ Subject "${subject}" added to ${className}!`,'success');
}

