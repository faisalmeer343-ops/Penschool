function saveAdmission(){
  const name=document.getElementById('admName').value.trim();
  const father=document.getElementById('admFather').value.trim();
  const admissionNo=document.getElementById('admAdmissionNo').value.trim();
  if(!name||!father){showToast('⚠️ Name and Father are required!','error');return;}
  if(!admissionNo){showToast('⚠️ Admission Number is required!','error');return;}
  if(!editingStudentId){
    const exists=AppData.students.find(s=>s.admissionNo===admissionNo);
    if(exists){showToast('⚠️ Admission Number already exists!','error');return;}
  }else{
    const exists=AppData.students.find(s=>s.admissionNo===admissionNo&&s.id!==editingStudentId);
    if(exists){showToast('⚠️ Admission Number already exists for another student!','error');return;}
  }
  const subjects=Array.from(document.querySelectorAll('.adm-subject-check:checked')).map(cb=>cb.value);
  const admissionFee=parseFloat(document.getElementById('admAdmissionFee').value)||0;
  const securityFee=parseFloat(document.getElementById('admSecurityFee').value)||0;
  const monthlyFee=parseFloat(document.getElementById('admMonthlyFee').value)||0;
  const annualFee=parseFloat(document.getElementById('admAnnualFee').value)||0;
  const registrationFee=parseFloat(document.getElementById('admRegistrationFee').value)||0;
  const booksFee=parseFloat(document.getElementById('admBooksFee').value)||0;
  const uniformFee=parseFloat(document.getElementById('admUniformFee').value)||0;
  const stationaryFee=parseFloat(document.getElementById('admStationaryFee').value)||0;
  const othersFee=parseFloat(document.getElementById('admOthersFee').value)||0;
  const discount=parseFloat(document.getElementById('admDiscount').value)||0;
  const subtotal=admissionFee+securityFee+monthlyFee+annualFee+registrationFee+booksFee+uniformFee+stationaryFee+othersFee;
  const discountAmount=(subtotal*discount)/100;
  const totalFee=subtotal-discountAmount;
  const studentData={
    admissionNo:admissionNo,
    rollNo:document.getElementById('admRollNo').value.trim(),
    admissionDate:document.getElementById('admAdmissionDate').value,
    name:name,
    fatherName:father,
    dob:document.getElementById('admDob').value,
    gender:document.getElementById('admGender').value,
    free:document.getElementById('admFree').value,
    motherName:document.getElementById('admMother').value.trim(),
    fatherNic:document.getElementById('admFatherNic').value.trim(),
    address:document.getElementById('admAddress').value.trim(),
    remarks:document.getElementById('admRemarks').value.trim(),
    bloodGroup:document.getElementById('admBloodGroup').value,
    prevSchool:document.getElementById('admPrevSchool').value.trim(),
    admittedClass:document.getElementById('admAdmittedClass').value,
    currentClass:document.getElementById('admCurrentClass').value,
    group:document.getElementById('admGroup').value.trim(),
    session:document.getElementById('admSession').value.trim(),
    status:document.getElementById('admStatus').value,
    occupation:document.getElementById('admOccupation').value.trim(),
    nationality:document.getElementById('admNationality').value,
    religion:document.getElementById('admReligion').value,
    cast:document.getElementById('admCast').value.trim(),
    contactNumber:document.getElementById('admContact').value.trim(),
    guardianName:document.getElementById('admGuardianName').value.trim(),
    guardianRelation:document.getElementById('admGuardianRelation').value.trim(),
    guardianContact:document.getElementById('admGuardianContact').value.trim(),
    guardianAddress:document.getElementById('admGuardianAddress').value.trim(),
    guardianPhone:document.getElementById('admGuardianPhone').value.trim(),
    admissionFee:admissionFee,
    securityFee:securityFee,
    monthlyFee:monthlyFee,
    annualFee:annualFee,
    registrationFee:registrationFee,
    booksFee:booksFee,
    uniformFee:uniformFee,
    stationaryFee:stationaryFee,
    othersFee:othersFee,
    discount:discount,
    discountAmount:discountAmount,
    totalFee:totalFee,
    subjects:subjects,
    photo:admissionPhotoData||'',
    familyGroup:'',
    createdAt:new Date().toISOString()
  };
  if(editingStudentId){
    const idx=AppData.students.findIndex(s=>s.id===editingStudentId);
    if(idx!==-1){
      AppData.students[idx]={...AppData.students[idx],...studentData};
      showToast(`✅ Student ${name} updated!`,'success');
    }
    editingStudentId=null;
  }else{
    studentData.id=generateStudentId();
    AppData.students.push(studentData);
    showToast(`✅ Student ${name} admitted! Admission No: ${studentData.admissionNo}`,'success');
  }
  if(selectedInquiryForAdmission){
    const inquiry=AppData.inquiries.find(i=>i.id===selectedInquiryForAdmission);
    if(inquiry){inquiry.status='Admitted';inquiry.admittedDate=getTodayDateFormatted();}
    selectedInquiryForAdmission=null;
  }
  saveToStorage();
  clearAdmissionForm();
  renderStudents();
}

