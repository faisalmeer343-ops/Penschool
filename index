function addFeeHeadRow(name,amount,discount){
  const container=document.getElementById('feeHeadsContainer');
  const index=feeHeadRows.length;
  const row=document.createElement('div');
  row.className='fee-head-row';
  row.id='feeHeadRow_'+index;
  row.innerHTML=`
    <input type="text" class="fee-head-name" data-index="${index}" value="${name||''}" placeholder="Fee head name" oninput="calcFeeChallanTotal()" />
    <input type="number" class="fee-head-amount" data-index="${index}" value="${amount||0}" placeholder="Amount" oninput="calcFeeChallanTotal()" />
    <input type="number" class="fee-head-discount" data-index="${index}" value="${discount||0}" placeholder="Discount %" oninput="calcFeeChallanTotal()" />
    <button class="remove-btn" onclick="removeFeeHeadRow(${index})">✕</button>
  `;
  container.appendChild(row);
  feeHeadRows.push({name:name||'',amount:amount||0,discount:discount||0});
}

function removeFeeHeadRow(index){
  const row=document.getElementById('feeHeadRow_'+index);
  if(row){row.remove();feeHeadRows.splice(index,1);calcFeeChallanTotal();}
}

function calcFeeChallanTotal(){
  let total=0;
  document.querySelectorAll('.fee-head-amount').forEach(el=>{
    const idx=parseInt(el.dataset.index);
    const amount=parseFloat(el.value)||0;
    const discount=parseFloat(document.querySelector(`.fee-head-discount[data-index="${idx}"]`).value)||0;
    total+=amount*(1-discount/100);
  });
  const familyDiscount=parseFloat(document.getElementById('fcFamilyDiscount').value)||0;
  const familyDiscountAmount=(total*familyDiscount)/100;
  const finalTotal=total-familyDiscountAmount;
  document.getElementById('fcTotal').value=finalTotal.toFixed(2);
}

