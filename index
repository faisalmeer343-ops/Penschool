function renderStudents(){
  const container=document.getElementById('contentArea');
  const students=AppData.students;
  let html=`
    <div class="card">
      <div class="card-title"><span class="prompt">&gt;&gt;&gt;</span> All Students <span class="badge">${students.length}</span></div>
      <div class="search-bar">
        <label>🔍 Search:</label>
        <input id="studentSearchInput" placeholder="Name, Father Name, Admission No, Address..." oninput="filterStudentsWithSearch()" />
        <label>Class:</label>
        <select id="studentClassFilter" onchange="filterStudentsWithSearch()">
          <option value="All">All</option>
          ${(AppData.schoolSettings.classes||[]).map(c=>`<option value="${c}">${c}</option>`).join('')}
        </select>
        <button class="btn btn-success btn-sm" onclick="showTab('admission')">➕ Add New</button>
      </div>
      <div class="table-wrap">
        <table>
          <thead><tr><th>Admission No</th><th>Roll No</th><th>Name</th><th>Father</th><th>Class</th><th>Phone</th><th>Status</th><th>Actions</th></tr></thead>
          <tbody id="studentsTableBody">
  `;
  if(students.length===0){
    html+=`<tr><td colspan="8" style="padding:14px;color:var(--text-muted);text-align:center;">No students added yet</td></tr>`;
  }else{
    students.forEach(s=>{
      const statusClass=s.status==='Currently-in'?'badge-paid':'badge-pending';
      html+=`<tr>
        <td><strong>${s.admissionNo}</strong></td>
        <td>${s.rollNo||'N/A'}</td>
        <td>${s.name}</td>
        <td>${s.fatherName}</td>
        <td>${s.currentClass}</td>
        <td>${s.contactNumber||'N/A'}</td>
        <td><span class="badge-status ${statusClass}">${s.status}</span></td>
        <td>
          <button class="btn btn-info btn-xs" onclick="viewStudent('${s.id}')">📄</button>
          <button class="btn btn-primary btn-xs" onclick="editStudent('${s.id}')">✏️</button>
          <button class="btn btn-danger btn-xs" onclick="deleteStudent('${s.id}')">🗑️</button>
          <button class="btn btn-warning btn-xs" onclick="printAdmissionFormWithPhoto('${s.id}')">🖨️ Form</button>
        </td>
      </tr>`;
    });
  }
  html+=`</tbody></table></div></div>`;
  container.innerHTML=html;
}

function filterStudentsWithSearch(){
  const search=document.getElementById('studentSearchInput').value.toLowerCase();
  const classFilter=document.getElementById('studentClassFilter').value;
  const tbody=document.getElementById('studentsTableBody');
  let filtered=AppData.students;
  if(search){
    filtered=filtered.filter(s=>
      s.name.toLowerCase().includes(search)||
      s.fatherName.toLowerCase().includes(search)||
      s.admissionNo.toLowerCase().includes(search)||
      (s.address||'').toLowerCase().includes(search)||
      (s.contactNumber||'').includes(search)
    );
  }
  if(classFilter!=='All'){filtered=filtered.filter(s=>s.currentClass===classFilter);}
  if(filtered.length===0){
    tbody.innerHTML=`<tr><td colspan="8" style="padding:14px;color:var(--text-muted);text-align:center;">No students found</td></tr>`;
    return;
  }
  tbody.innerHTML=filtered.map(s=>{
    const statusClass=s.status==='Currently-in'?'badge-paid':'badge-pending';
    return `<tr>
      <td><strong>${s.admissionNo}</strong></td>
      <td>${s.rollNo||'N/A'}</td>
      <td>${s.name}</td>
      <td>${s.fatherName}</td>
      <td>${s.currentClass}</td>
      <td>${s.contactNumber||'N/A'}</td>
      <td><span class="badge-status ${statusClass}">${s.status}</span></td>
      <td>
        <button class="btn btn-info btn-xs" onclick="viewStudent('${s.id}')">📄</button>
        <button class="btn btn-primary btn-xs" onclick="editStudent('${s.id}')">✏️</button>
        <button class="btn btn-danger btn-xs" onclick="deleteStudent('${s.id}')">🗑️</button>
        <button class="btn btn-warning btn-xs" onclick="printAdmissionFormWithPhoto('${s.id}')">🖨️ Form</button>
      </td>
    </tr>`;
  }).join('');
}

function viewStudent(id){
  const student=getStudent(id);
  if(!student) return;
  const details=`Student: ${student.name}
Admission No: ${student.admissionNo}
Father: ${student.fatherName}
Class: ${student.currentClass}
Status: ${student.status}
Address: ${student.address||'N/A'}`;
  alert(details);
}

function editStudent(id){
  const student=getStudent(id);
  if(!student) return;
  editingStudentId=id;
  showTab('admission');
  setTimeout(()=>{
    const s=getStudent(id);
    if(!s) return;
    document.getElementById('admAdmissionNo').value=s.admissionNo;
    document.getElementById('admRollNo').value=s.rollNo||'';
    document.getElementById('admAdmissionDate').value=s.admissionDate||'';
    document.getElementById('admName').value=s.name;
    document.getElementById('admFather').value=s.fatherName;
    document.getElementById('admDob').value=s.dob||'';
    document.getElementById('admGender').value=s.gender||'Male';
    document.getElementById('admFree').value=s.free||'No';
    document.getElementById('admMother').value=s.motherName||'';
    document.getElementById('admFatherNic').value=s.fatherNic||'';
    document.getElementById('admAddress').value=s.address||'';
    document.getElementById('admRemarks').value=s.remarks||'';
    document.getElementById('admBloodGroup').value=s.bloodGroup||'';
    document.getElementById('admPrevSchool').value=s.prevSchool||'';
    document.getElementById('admAdmittedClass').value=s.admittedClass||s.currentClass;
    document.getElementById('admCurrentClass').value=s.currentClass;
    document.getElementById('admGroup').value=s.group||'';
    document.getElementById('admSession').value=s.session||'';
    document.getElementById('admStatus').value=s.status||'Currently-in';
    document.getElementById('admOccupation').value=s.occupation||'';
    document.getElementById('admNationality').value=s.nationality||'Pakistani';
    document.getElementById('admReligion').value=s.religion||'Islam';
    document.getElementById('admCast').value=s.cast||'';
    document.getElementById('admContact').value=s.contactNumber||'';
    document.getElementById('admGuardianName').value=s.guardianName||'';
    document.getElementById('admGuardianRelation').value=s.guardianRelation||'';
    document.getElementById('admGuardianContact').value=s.guardianContact||'';
    document.getElementById('admGuardianAddress').value=s.guardianAddress||'';
    document.getElementById('admGuardianPhone').value=s.guardianPhone||'';
    if(s.photo){admissionPhotoData=s.photo;document.getElementById('admPhotoImg').src=s.photo;document.getElementById('admPhotoPreview').style.display='block';}
    showToast('✏️ Editing student. Click Save to update.','info');
  },100);
}

function deleteStudent(id){
  if(!confirm('Delete this student?')) return;
  const student=getStudent(id);
  AppData.students=AppData.students.filter(s=>s.id!==id);
  saveToStorage();
  renderStudents();
  showToast(`🗑️ Student ${student.name} deleted!`,'info');
}

