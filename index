function createStudentSearchSelect(containerId,selectedId,placeholder='Search student by name, admission no...'){
  const container=document.getElementById(containerId);
  if(!container) return;
  const students=AppData.students;
  let html=`
    <div class="student-search-select">
      <input type="text" id="${selectedId}_search" placeholder="${placeholder}" autocomplete="off" onfocus="toggleStudentDropdown('${selectedId}', true)" oninput="filterStudentDropdown('${selectedId}')" />
      <input type="hidden" id="${selectedId}" value="" />
      <div class="dropdown" id="${selectedId}_dropdown">
        <div class="item" data-value="" onclick="selectStudent('${selectedId}', '', '')">-- Select Student --</div>
        ${students.map(s=>`<div class="item" data-value="${s.id}" onclick="selectStudent('${selectedId}', '${s.id}', '${s.name} (${s.admissionNo})')"><span class="adm-no">${s.admissionNo}</span> - ${s.name} (${s.fatherName})</div>`).join('')}
      </div>
    </div>
  `;
  container.innerHTML=html;
}

function toggleStudentDropdown(id,show){
  const dropdown=document.getElementById(id+'_dropdown');
  if(!dropdown) return;
  if(show){dropdown.classList.add('show');}
  else{setTimeout(()=>{dropdown.classList.remove('show');},200);}
}

function filterStudentDropdown(id){
  const search=document.getElementById(id+'_search');
  const dropdown=document.getElementById(id+'_dropdown');
  if(!search||!dropdown) return;
  const query=search.value.toLowerCase();
  const items=dropdown.querySelectorAll('.item');
  items.forEach(item=>{
    const text=item.textContent.toLowerCase();
    if(text.includes(query)||query===''){item.style.display='block';}
    else{item.style.display='none';}
  });
  dropdown.classList.add('show');
}

function selectStudent(id,value,label){
  const hidden=document.getElementById(id);
  const search=document.getElementById(id+'_search');
  const dropdown=document.getElementById(id+'_dropdown');
  if(hidden) hidden.value=value;
  if(search) search.value=label||'';
  if(dropdown) dropdown.classList.remove('show');
  const event=new Event('change',{bubbles:true});
  if(hidden) hidden.dispatchEvent(event);
}

document.addEventListener('click',function(e){
  document.querySelectorAll('.student-search-select .dropdown').forEach(d=>{
    if(!d.closest('.student-search-select').contains(e.target)){d.classList.remove('show');}
  });
});

