      .report-date{text-align:right;font-size:10pt;color:#565959;margin-bottom:8px;}
      table{width:100%;border-collapse:collapse;font-size:10pt;margin-top:5px;}
      th{background:#131921;color:#ffffff;border:1px solid #232f3e;padding:6px 8px;font-weight:900;font-family:'Times New Roman',Times,serif;font-size:11pt;text-align:center;}
      td{border:1px solid #ddd;padding:5px 8px;text-align:center;}
      tr:nth-child(even) td{background:#f7fafc;}
      .summary{background:#ebf4ff;padding:8px 12px;border:2px solid #131921;margin:8px 0;font-weight:900;font-size:11pt;}
      .footer{text-align:center;font-size:10pt;color:#565959;margin-top:15px;border-top:1px solid #ddd;padding-top:8px;}
