        <div><label>Father Phone</label><input id="inqFatherPhone" placeholder="03XXXXXXXXX" /></div>
        <div><label>Mother Phone</label><input id="inqMotherPhone" placeholder="03XXXXXXXXX" /></div>
        <div><label>Personal Phone</label><input id="inqPersonalPhone" placeholder="03XXXXXXXXX" /></div>
        <div><label>Address</label><input id="inqAddress" placeholder="Address" /></div>
        <div><label>Fee</label><input type="number" id="inqFee" value="0" /></div>
        <div><label>Inquiry Date</label><input type="date" id="inqDate" value="${getTodayDateInput()}" /></div>
        <div><label>Remarks</label><input id="inqRemarks" placeholder="Any remarks" /></div>
        <div class="full-width">
          <div class="btn-group">
            <button class="btn btn-success" onclick="saveInquiry()">💾 Save Inquiry</button>
            <button class="btn btn-warning" onclick="clearInquiryForm()">🔄 Clear</button>
            <button class="btn btn-primary" onclick="printInquiry()">🖨️ Print Inquiry</button>
          </div>
        </div>
      </div>
      <div class="search-bar" style="margin-top:10px;">
        <label>🔍 Search:</label>
        <input id="inqSearch" placeholder="Name, Father, Phone..." oninput="filterInquiries()" />
        <label>Status:</label>
        <select id="inqStatusFilter" onchange="filterInquiries()">
          <option value="All">All</option>
          <option value="Pending">Pending</option>
          <option value="Admitted">Admitted</option>
          <option value="Cancelled">Cancelled</option>
        </select>
      </div>
      <div class="table-wrap">
        <table>
          <thead><tr><th>Date</th><th>Name</th><th>Father</th><th>Class</th><th>Phone</th><th>Fee</th><th>Status</th><th>Actions</th></tr></thead>
          <tbody id="inquiryTableBody">
  `;
  if(inquiries.length===0){
    html+=`<tr><td colspan="8" style="padding:14px;color:var(--text-muted);text-align:center;">No inquiries yet</td></tr>`;
  }else{
    inquiries.slice().reverse().forEach(i=>{
      const statusClass=i.status==='Pending'?'badge-pending':i.status==='Admitted'?'badge-paid':'badge-inactive';
      html+=`<tr>
        <td>${i.inquiryDate?formatDate(i.inquiryDate):'N/A'}</td>
        <td><strong>${i.name}</strong></td>
        <td>${i.fatherName}</td>
