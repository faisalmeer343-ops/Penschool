function saveEmployee(){
  const name=document.getElementById('empName').value.trim();
  const empId=document.getElementById('empId').value.trim();
  if(!name){showToast('⚠️ Name is required!','error');return;}
  if(!empId){showToast('⚠️ Employee ID is required!','error');return;}
  const existing=AppData.employees.find(e=>e.empId===empId);
  const employeeData={
    id:existing?existing.id:generateEmployeeId(),
    empId:empId,
    name:name,
    designation:document.getElementById('empDesignation').value,
    department:document.getElementById('empDepartment').value,
    mobile:document.getElementById('empMobile').value.trim(),
    status:document.getElementById('empStatus').value,
    salary:parseFloat(document.getElementById('empSalary').value)||0,
    photo:employeePhotoData||'',
    allowances:{attendance:0,spoken:0,productivity:0,stayBack:0,security:0,advanced:0,absentee:0}
  };
  if(existing){
    const index=AppData.employees.indexOf(existing);
    AppData.employees[index]=employeeData;
  }else{
    AppData.employees.push(employeeData);
  }
  saveToStorage();
  renderEmployees();
  showToast(`✅ Employee ${name} saved!`,'success');
}

function viewEmployee(id){
