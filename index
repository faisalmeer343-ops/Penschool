  const search=document.getElementById('empSearch').value.toLowerCase();
  const tbody=document.getElementById('employeesTableBody');
  let filtered=AppData.employees;
  if(search){filtered=filtered.filter(e=>e.name.toLowerCase().includes(search)||e.empId.toLowerCase().includes(search));}
  if(filtered.length===0){
    tbody.innerHTML=`<tr><td colspan="7" style="padding:14px;color:var(--text-muted);text-align:center;">No employees found</td></tr>`;
    return;
  }
  tbody.innerHTML=filtered.map(e=>{
    const statusClass=e.status==='Active'?'badge-active':'badge-inactive';
    return `<tr>
      <td><strong>${e.empId}</strong></td>
      <td>${e.name}</td>
      <td>${e.designation||'N/A'}</td>
      <td><span class="badge-status ${statusClass}">${e.status}</span></td>
