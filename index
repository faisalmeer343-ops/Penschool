function createFamilyGroup(){
  const name=document.getElementById('familyGroupName').value.trim();
  const discount=parseFloat(document.getElementById('familyDiscountPercent').value)||0;
  if(!name){showToast('⚠️ Family name is required!','error');return;}
  const exists=AppData.familyGroups.find(g=>g.name.toLowerCase()===name.toLowerCase());
  if(exists){showToast('⚠️ Family name already exists!','error');return;}
  AppData.familyGroups.push({
    id:'FAM'+String(AppData.familyGroups.length+1).padStart(4,'0'),
    name:name,
    discount:discount,
    members:[]
  });
  saveToStorage();
  renderFamilyDiscount();
  showToast(`✅ Family "${name}" created with ${discount}% discount!`,'success');
}

function addStudentToFamily(){
  const studentId=document.getElementById('familyStudentSelect').value;
  const familyId=document.getElementById('familyGroupSelect').value;
  if(!studentId){showToast('⚠️ Select a student!','error');return;}
  if(!familyId){showToast('⚠️ Select a family!','error');return;}
  const student=getStudent(studentId);
  if(!student) return;
  const family=AppData.familyGroups.find(g=>g.id===familyId);
  if(!family) return;
  for(let g of AppData.familyGroups){
    if(g.members.includes(studentId)){showToast('⚠️ Student already in a family!','error');return;}
  }
  family.members.push(studentId);
  student.familyGroup=family.name;
  student.discount=family.discount;
  saveToStorage();
  renderFamilyDiscount();
  showToast(`✅ ${student.name} added to ${family.name}!`,'success');
}

function removeStudentFromFamily(familyId,studentId){
  const family=AppData.familyGroups.find(g=>g.id===familyId);
  if(!family) return;
  family.members=family.members.filter(m=>m!==studentId);
  const student=getStudent(studentId);
  if(student){student.familyGroup='';student.discount=0;}
  if(family.members.length===0){AppData.familyGroups=AppData.familyGroups.filter(g=>g.id!==familyId);}
  saveToStorage();
  renderFamilyDiscount();
  showToast('🗑️ Student removed from family!','info');
}

function deleteFamilyGroup(familyId){
  if(!confirm('Delete this family group?')) return;
  const family=AppData.familyGroups.find(g=>g.id===familyId);
  if(family){
    family.members.forEach(m=>{
      const student=getStudent(m);
      if(student){student.familyGroup='';student.discount=0;}
    });
  }
  AppData.familyGroups=AppData.familyGroups.filter(g=>g.id!==familyId);
  saveToStorage();
  renderFamilyDiscount();
  showToast('🗑️ Family group deleted!','info');
}

