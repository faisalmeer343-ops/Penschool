function addExpenseRow(){
  const container=document.getElementById('expenseContainer');
  const index=expenseItems.length;
  const row=document.createElement('div');
  row.className='expense-row';
  row.id='expRow_'+index;
  row.innerHTML=`
    <input type="text" class="exp-item" data-index="${index}" placeholder="Item name" />
    <input type="number" class="exp-qty" data-index="${index}" value="1" oninput="calcExpenseRow(${index})" />
    <input type="number" class="exp-rate" data-index="${index}" value="0" oninput="calcExpenseRow(${index})" />
    <input type="number" class="exp-total" data-index="${index}" readonly style="background:#f7fafc;font-weight:900;color:var(--accent-blue);" />
    <button class="remove-btn" onclick="removeExpenseRow(${index})">✕</button>
  `;
  container.appendChild(row);
  expenseItems.push({item:'',qty:1,rate:0,total:0});
  calcExpenseRow(index);
  updateExpenseGrandTotal();
}

function calcExpenseRow(index){
  const qty=parseFloat(document.querySelector(`.exp-qty[data-index="${index}"]`).value)||0;
  const rate=parseFloat(document.querySelector(`.exp-rate[data-index="${index}"]`).value)||0;
  const total=qty*rate;
  document.querySelector(`.exp-total[data-index="${index}"]`).value=total.toFixed(2);
  updateExpenseGrandTotal();
}

function removeExpenseRow(index){
  const row=document.getElementById('expRow_'+index);
  if(row){row.remove();expenseItems.splice(index,1);updateExpenseGrandTotal();}
}

function updateExpenseGrandTotal(){
  let total=0;
  document.querySelectorAll('.exp-total').forEach(el=>{total+=parseFloat(el.value)||0;});
  document.getElementById('expGrandTotal').value=total.toFixed(2);
}

function saveExpenditure(){
  const date=document.getElementById('expDate').value||getTodayDateInput();
  const items=[];
  let grandTotal=0;
  document.querySelectorAll('.exp-item').forEach(el=>{
    const idx=parseInt(el.dataset.index);
    const qty=parseFloat(document.querySelector(`.exp-qty[data-index="${idx}"]`).value)||0;
    const rate=parseFloat(document.querySelector(`.exp-rate[data-index="${idx}"]`).value)||0;
    const total=qty*rate;
    const itemName=el.value.trim();
    if(itemName&&qty>0&&rate>0){items.push({item:itemName,qty:qty,rate:rate,total:total});grandTotal+=total;}
  });
  if(items.length===0){showToast('⚠️ Add at least one item!','error');return;}
  AppData.expenditures.push({
    id:'EXP'+String(AppData.expenditures.length+1).padStart(4,'0'),
    date:date,time:getCurrentTime(),items:items,grandTotal:grandTotal,createdAt:new Date().toISOString()
  });
  saveToStorage();
  loadExpenditures();
  clearExpenditure();
  showToast(`✅ Expenditure saved: ${formatCurrency(grandTotal)}`,'success');
}

function loadExpenditures(){
  const tbody=document.getElementById('expTableBody');
  const expenditures=AppData.expenditures;
  if(expenditures.length===0){
    tbody.innerHTML=`<tr><td colspan="6" style="padding:14px;color:var(--text-muted);text-align:center;">No expenditures</td></tr>`;
    return;
  }
  let html='';
  expenditures.slice().reverse().forEach(exp=>{
    exp.items.forEach((item,i)=>{
      html+=`<tr><td>${i===0?exp.date:''}</td><td>${i===0?(exp.time||'N/A'):''}</td><td>${item.item}</td><td>${item.qty}</td><td>${formatCurrency(item.rate)}</td><td style="color:var(--accent-red);font-weight:900;">${formatCurrency(item.total)}</td></tr>`;
    });
    html+=`<tr style="font-weight:900;background:var(--bg-primary);"><td colspan="5" style="text-align:right;">Total for ${exp.date}:</td><td style="color:var(--accent-red);">${formatCurrency(exp.grandTotal)}</td></tr>`;
  });
  tbody.innerHTML=html;
}

function clearExpenditure(){
  document.getElementById('expDate').value=getTodayDateInput();
  document.getElementById('expGrandTotal').value='';
  document.getElementById('expenseContainer').innerHTML='';
  expenseItems=[];
  addExpenseRow();
  showToast('🔄 Cleared!','info');
}

function printExpenditure(){
  const content=document.getElementById('expTableWrap').innerHTML;
  if(!content||content.includes('No expenditures')){showToast('⚠️ No data to print!','error');return;}
  const settings=AppData.schoolSettings||{};
  const win=window.open('','_blank');
