function loadComparison(){
  const classFilter=document.getElementById('compClassFilter').value;
  const examFilter=document.getElementById('compExamFilter').value;
  const display=document.getElementById('comparisonDisplay');
  let results=(AppData.results||[]).slice();
  if(classFilter!=='All') results=results.filter(r=>r.className===classFilter);
  if(examFilter!=='All') results=results.filter(r=>r.exam===examFilter);
  if(results.length===0){
    display.innerHTML='<p style="color:var(--text-muted);text-align:center;padding:20px;">No results found for selected filters</p>';
    return;
  }
  // Group by student
  const studentMap={};
  results.forEach(r=>{
    if(!studentMap[r.studentId]){
      studentMap[r.studentId]={
        studentId:r.studentId,
        studentName:r.studentName,
        admissionNo:r.admissionNo,
        className:r.className,
        exams:[]
      };
    }
    studentMap[r.studentId].exams.push(r);
  });
  const students=Object.values(studentMap);
  let html='';
  students.forEach(s=>{
    // Sort exams by date
    s.exams.sort((a,b)=>{
      const dateA=a.date?a.date.split('/').reverse().join(''):'';
      const dateB=b.date?b.date.split('/').reverse().join(''):'';
      return dateA.localeCompare(dateB);
    });
    const latestExam=s.exams[s.exams.length-1];
    const avgPercentage=s.exams.reduce((sum,e)=>sum+(e.percentage||0),0)/s.exams.length;
    const bestExam=s.exams.reduce((best,e)=>(e.percentage||0)>(best.percentage||0)?e:best,s.exams[0]);
    const worstExam=s.exams.reduce((worst,e)=>(e.percentage||0)<(worst.percentage||0)?e:worst,s.exams[0]);
    const trend=s.exams.length>=2?
      (s.exams[s.exams.length-1].percentage||0)-(s.exams[0].percentage||0):0;
    const trendIcon=trend>0?'📈':trend<0?'📉':'➡️';
    const trendColor=trend>0?'var(--accent-green)':trend<0?'var(--accent-red)':'var(--text-muted)';
    const latestGrade=latestExam.grade||'N/A';
    const latestStatus=latestExam.status||'N/A';
    const statusColor=latestStatus==='Pass'?'var(--accent-green)':'var(--accent-red)';
    const avgColor=avgPercentage>=70?'var(--accent-green)':avgPercentage>=50?'var(--accent-gold)':'var(--accent-red)';
    html+=`
      <div class="comparison-card">
        <div class="student-header">
          <div>
            <div class="student-name">👨‍🎓 ${s.studentName}</div>
            <div class="student-class">${s.admissionNo} | ${s.className}</div>
          </div>
          <div style="text-align:right;">
            <div style="font-size:12px;color:var(--text-muted);">Exams Taken: ${s.exams.length}</div>
            <div style="font-size:12px;color:${statusColor};font-weight:900;">Latest: ${latestStatus} (${latestGrade})</div>
          </div>
        </div>
        <div class="exam-row header">
          <span>Exam</span><span>Date</span><span>Total</span><span>Obtained</span><span>%</span>
        </div>
        ${s.exams.map(e=>{
          const pct=e.percentage||0;
          const barColor=pct>=70?'green':pct>=50?'gold':'red';
          return `<div class="exam-row">
            <span>${e.exam||'N/A'}</span>
            <span>${e.date||'N/A'}</span>
            <span>${e.totalMarks||0}</span>
            <span>${e.obtainedMarks||0}</span>
            <span>
              <strong style="color:${barColor==='green'?'var(--accent-green)':barColor==='gold'?'var(--accent-gold)':'var(--accent-red)'}">${pct.toFixed(1)}%</strong>
              <div class="progress-bar"><div class="fill ${barColor}" style="width:${Math.min(pct,100)}%"></div></div>
            </span>
          </div>`;
        }).join('')}
        <div class="summary-row">
          <div class="item"><div class="label">Average %</div><div class="value" style="color:${avgColor};">${avgPercentage.toFixed(1)}%</div></div>
          <div class="item"><div class="label">Best Exam</div><div class="value" style="color:var(--accent-green);">${bestExam.exam} (${(bestExam.percentage||0).toFixed(0)}%)</div></div>
          <div class="item"><div class="label">Weakest Exam</div><div class="value" style="color:var(--accent-red);">${worstExam.exam} (${(worstExam.percentage||0).toFixed(0)}%)</div></div>
          <div class="item"><div class="label">Trend</div><div class="value" style="color:${trendColor};">${trendIcon} ${trend>0?'+':''}${trend.toFixed(1)}%</div></div>
        </div>
      </div>
    `;
  });
  display.innerHTML=html;
}

