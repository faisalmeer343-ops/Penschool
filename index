        <div style="padding:6px 10px;background:var(--bg-primary);border-radius:4px;"><strong>Attendance Records:</strong> ${(AppData.attendance||[]).length}</div>
        <div style="padding:6px 10px;background:var(--bg-primary);border-radius:4px;"><strong>Receipt Counter:</strong> ${AppData.receiptCounter||0}</div>
        <div style="padding:6px 10px;background:var(--bg-primary);border-radius:4px;"><strong>Classes:</strong> ${classes.length}</div>
        <div style="padding:6px 10px;background:var(--bg-primary);border-radius:4px;"><strong>Storage:</strong> ${(new Blob([JSON.stringify(AppData)]).size/1024).toFixed(2)} KB</div>
      </div>
    </div>
  `;
  container.innerHTML=html;
}

function previewSettingsLogo(input){
  const file=input.files[0];
  if(file){
    const reader=new FileReader();
    reader.onload=function(e){document.getElementById('settingsLogoPreview').innerHTML=`<img src="${e.target.result}" alt="Logo" />`;};
    reader.readAsDataURL(file);
  }
}

function removeSettingsLogo(){
  document.getElementById('settingsLogoPreview').innerHTML=`<span class="no-logo">🏫</span>`;
  document.getElementById('setLogo').value='';
}

function saveSettingsWithPassword(){showSettingsPasswordModal(()=>{saveSettings();});}

function saveSettings(){
  const settings=AppData.schoolSettings||{};
  const fileInput=document.getElementById('setLogo');
  if(fileInput.files&&fileInput.files[0]){
    const reader=new FileReader();
    reader.onload=function(e){settings.logo=e.target.result;applySettings(settings);};
    reader.readAsDataURL(fileInput.files[0]);
  }else{
    const preview=document.getElementById('settingsLogoPreview');
    const img=preview.querySelector('img');
    settings.logo=img?img.src:'';
    applySettings(settings);
  }
}

function applySettings(settings){
  settings.schoolName=document.getElementById('setSchoolName').value.trim()||'SUBHANI ACADEMY SCHOOL';
  settings.schoolAddress=document.getElementById('setAddress').value.trim()||'';
  settings.schoolPhone=document.getElementById('setPhone').value.trim()||'';
  settings.schoolEmail=document.getElementById('setEmail').value.trim()||'';
  settings.settingsPassword=document.getElementById('setPassword').value.trim()||'admin123';
  settings.adminPassword=document.getElementById('setAdminPassword').value.trim()||'admin123';
  settings.logoSize=parseInt(document.getElementById('setLogoSize').value)||60;
  AppData.schoolSettings=settings;
  saveToStorage();
  updateTopBar();
  showToast('✅ Settings saved successfully!','success');
}

