            ${feeHeads.map(fh=>`<div class="row"><span class="label">${fh.name}</span><span class="value">${formatCurrency(fh.total)}</span></div>`).join('')}
            ${discountAmount>0?`<div class="row"><span class="label" style="color:#067d62;">Family Discount (${discount}%)</span><span class="value" style="color:#067d62;">-${formatCurrency(discountAmount)}</span></div>`:''}
          </div>
