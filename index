          <thead><tr><th>Date</th><th>Time</th><th>Item</th><th>Qty</th><th>Rate</th><th>Total</th></tr></thead>
          <tbody id="expTableBody"></tbody>
        </table>
      </div>
    </div>
  `;
  container.innerHTML=html;
  loadExpenditures();
  addExpenseRow();
