          <div class="v-qr" id="${qrId}"></div>
          <div class="v-footer">${settings.schoolName||'SUBHANI ACADEMY SCHOOL'} — Success with Wisdom</div>
        </div>
      `;
    });
  });
  saveToStorage();
  if(totalCount===0){
    display.innerHTML='<p style="color:var(--text-muted);text-align:center;padding:20px;">No valid students selected</p>';
    return;
  }
  display.innerHTML=`<div class="voucher-print-area">${allVouchers}</div>`;
  // Generate QR codes for each voucher
  selected.forEach(cb=>{
    const studentId=cb.value;
    const student=getStudent(studentId);
    if(!student) return;
    const challans=AppData.feeChallans.filter(c=>c.studentId===studentId&&c.month===month&&c.year===year);
    const lastChallan=challans[challans.length-1];
    if(lastChallan){
      const copies=['Student Copy','School Copy','Bank Copy'];
      copies.forEach(copy=>{
        const qrId='bqr_'+lastChallan.id+'_'+copy.replace(/\s/g,'_');
        const qrDiv=document.getElementById(qrId);
        if(qrDiv&&typeof QRCode!=='undefined'){
          const qrData=JSON.stringify({
            challan:lastChallan.id,
            student:student.name,
            father:student.fatherName,
            admission:student.admissionNo,
            class:student.currentClass,
            amount:lastChallan.total,
            month:month+' '+year,
            due:lastChallan.dueDate?formatDate(lastChallan.dueDate):'N/A'
          });
          new QRCode(qrDiv,{text:qrData,width:70,height:70,colorDark:'#131921',colorLight:'#ffffff'});
        }
      });
    }
  });
  showToast(`✅ ${totalCount} students vouchers generated with QR Code!`,'success');
}

