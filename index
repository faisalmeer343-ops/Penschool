function loadInquiryData(){
  const inquiryId=document.getElementById('admInquirySelect').value;
  if(!inquiryId) return;
  const inquiry=AppData.inquiries.find(i=>i.id===inquiryId);
  if(!inquiry) return;
  document.getElementById('admName').value=inquiry.name||'';
  document.getElementById('admFather').value=inquiry.fatherName||'';
  document.getElementById('admContact').value=inquiry.phone||'';
  document.getElementById('admAddress').value=inquiry.address||'';
  document.getElementById('admCurrentClass').value=inquiry.currentClass||'1st';
  document.getElementById('admAdmittedClass').value=inquiry.currentClass||'1st';
  updateSubjectSelection();
  selectedInquiryForAdmission=inquiryId;
  showToast('✅ Inquiry data loaded!','success');
}

function updateSubjectSelection(){
  const classVal=document.getElementById('admCurrentClass').value;
  const subjects=AppData.schoolSettings.subjects[classVal]||['English','Urdu','Math'];
  const container=document.getElementById('admSubjectsList');
  if(container){
    container.innerHTML=subjects.map(sub=>`<label style="display:flex;align-items:center;gap:4px;font-size:12px;font-weight:400;"><input type="checkbox" class="adm-subject-check" value="${sub}" checked /> ${sub}</label>`).join('');
  }
}

function addAdmissionSubject(){
  const input=document.getElementById('admNewSubject');
  const subject=input.value.trim();
  if(!subject){showToast('⚠️ Enter subject name!','error');return;}
  const container=document.getElementById('admSubjectsList');
  const label=document.createElement('label');
  label.style.cssText='display:flex;align-items:center;gap:4px;font-size:12px;font-weight:400;';
  label.innerHTML=`<input type="checkbox" class="adm-subject-check" value="${subject}" checked /> ${subject}`;
  container.appendChild(label);
  input.value='';
  showToast(`✅ Subject "${subject}" added!`,'success');
}

function calcAdmTotal(){
  const admissionFee=parseFloat(document.getElementById('admAdmissionFee').value)||0;
  const securityFee=parseFloat(document.getElementById('admSecurityFee').value)||0;
  const monthlyFee=parseFloat(document.getElementById('admMonthlyFee').value)||0;
  const annualFee=parseFloat(document.getElementById('admAnnualFee').value)||0;
  const registrationFee=parseFloat(document.getElementById('admRegistrationFee').value)||0;
  const booksFee=parseFloat(document.getElementById('admBooksFee').value)||0;
  const uniformFee=parseFloat(document.getElementById('admUniformFee').value)||0;
  const stationaryFee=parseFloat(document.getElementById('admStationaryFee').value)||0;
  const othersFee=parseFloat(document.getElementById('admOthersFee').value)||0;
  const discount=parseFloat(document.getElementById('admDiscount').value)||0;
  const subtotal=admissionFee+securityFee+monthlyFee+annualFee+registrationFee+booksFee+uniformFee+stationaryFee+othersFee;
  const discountAmount=(subtotal*discount)/100;
  const total=subtotal-discountAmount;
  document.getElementById('admTotalFee').value=total.toFixed(2);
}

function previewAdmissionPhoto(input){
  const file=input.files[0];
  if(file){
    const reader=new FileReader();
    reader.onload=function(e){
      admissionPhotoData=e.target.result;
      document.getElementById('admPhotoImg').src=e.target.result;
      document.getElementById('admPhotoPreview').style.display='block';
    };
    reader.readAsDataURL(file);
  }
}

