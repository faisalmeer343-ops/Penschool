function exportToExcel(data,filename,schoolName){
  if(!data||data.length===0){showToast('⚠️ No data to export!','error');return;}
  const settings=AppData.schoolSettings||{};
  const school=schoolName||settings.schoolName||'SUBHANI ACADEMY SCHOOL';
  const wsData=[[`School: ${school}`],[`Report Generated: ${getTodayDateFormatted()}`],[]];
  const headers=Object.keys(data[0]);
  wsData.push(headers);
  data.forEach(row=>{wsData.push(headers.map(h=>row[h]||''));});
  const ws=XLSX.utils.aoa_to_sheet(wsData);
  const wb=XLSX.utils.book_new();
  XLSX.utils.book_append_sheet(wb,ws,'Sheet1');
  XLSX.writeFile(wb,filename+'.xlsx');
  showToast('✅ Excel exported successfully!','success');
}

function exportToWord(content,filename,schoolName){
  if(!content){showToast('⚠️ No data to export!','error');return;}
  const settings=AppData.schoolSettings||{};
  const school=schoolName||settings.schoolName||'SUBHANI ACADEMY SCHOOL';
  const address=settings.schoolAddress||'';
  const html=`
    <html xmlns:o='urn:schemas-microsoft-com:office:office' xmlns:w='urn:schemas-microsoft-com:office:word' xmlns='http://www.w3.org/TR/REC-html40'>
    <head><meta charset="utf-8"><title>${filename}</title>
