function loadTransactions(){
  const period=document.getElementById('txPeriod').value;
  const tbody=document.getElementById('txTableBody');
  const summary=document.getElementById('txSummary');
  let filtered=AppData.transactions.slice();
  if(period==='daily'){
    const date=document.getElementById('txDate').value;
    filtered=filtered.filter(t=>t.date===formatDate(date));
  }else if(period==='weekly'){
    const date=document.getElementById('txDate').value;
    const d=new Date(date);
    const start=new Date(d);start.setDate(d.getDate()-d.getDay());
    const end=new Date(start);end.setDate(start.getDate()+6);
    filtered=filtered.filter(t=>{
      if(!t.date) return false;
      const parts=t.date.split('/');
      if(parts.length===3){const txDate=new Date(parts[2],parts[1]-1,parts[0]);return txDate>=start&&txDate<=end;}
      return false;
    });
  }else if(period==='monthly'){
    const date=document.getElementById('txDate').value;
    const d=new Date(date);const month=d.getMonth();const year=d.getFullYear();
    filtered=filtered.filter(t=>{
      if(!t.date) return false;
      const parts=t.date.split('/');
      if(parts.length===3){const txDate=new Date(parts[2],parts[1]-1,parts[0]);return txDate.getMonth()===month&&txDate.getFullYear()===year;}
      return false;
    });
  }else if(period==='yearly'){
    const date=document.getElementById('txDate').value;const year=new Date(date).getFullYear();
    filtered=filtered.filter(t=>{
      if(!t.date) return false;
      const parts=t.date.split('/');
      if(parts.length===3){const txDate=new Date(parts[2],parts[1]-1,parts[0]);return txDate.getFullYear()===year;}
      return false;
    });
  }else if(period==='custom'){
    const from=document.getElementById('txFrom').value;const to=document.getElementById('txTo').value;
    if(from&&to){
      const fromDate=new Date(from);const toDate=new Date(to);
      filtered=filtered.filter(t=>{
        if(!t.date) return false;
        const parts=t.date.split('/');
        if(parts.length===3){const txDate=new Date(parts[2],parts[1]-1,parts[0]);return txDate>=fromDate&&txDate<=toDate;}
        return false;
      });
    }
  }
  const total=filtered.reduce((sum,t)=>sum+(t.amount||0),0);
  summary.textContent=`Total Transactions: ${filtered.length} | Total Amount: ${formatCurrency(total)}`;
  window._txFiltered=filtered;
  if(filtered.length===0){
    tbody.innerHTML=`<tr><td colspan="7" style="padding:14px;color:var(--text-muted);text-align:center;">No transactions found</td></tr>`;
    return;
  }
  tbody.innerHTML=filtered.slice().reverse().map(t=>`
    <tr>
      <td>${t.date||'N/A'}</td>
      <td>${t.time||'N/A'}</td>
      <td>${t.studentName||'N/A'}</td>
      <td>${t.admissionNo||'N/A'}</td>
      <td>${t.type||'N/A'}</td>
      <td style="color:var(--accent-green);font-weight:900;">${formatCurrency(t.amount||0)}</td>
      <td>${t.receiptNo||'N/A'}</td>
    </tr>
  `).join('');
}

