function promoteAllStudents(){
  const currentClass=document.getElementById('promoCurrentClass').value;
  const toClass=document.getElementById('promoToClass').value;
  if(!currentClass||!toClass){showToast('⚠️ Select current and target class!','error');return;}
  const selected=Array.from(document.querySelectorAll('.promo-check:checked')).map(cb=>cb.value);
  if(selected.length===0){showToast('⚠️ Select at least one student!','error');return;}
  if(!confirm(`Promote ${selected.length} students from ${currentClass} to ${toClass}?`)) return;
  selected.forEach(id=>{
    const student=getStudent(id);
    if(student){
      AppData.promotions.push({
        id:'PRO'+String((AppData.promotions||[]).length+1).padStart(4,'0'),
        studentId:id,
        studentName:student.name,
        admissionNo:student.admissionNo,
        fromClass:currentClass,
        toClass:toClass,
        date:getTodayDateFormatted(),
        time:getCurrentTime(),
        promotedBy:currentUser
      });
      student.currentClass=toClass;
    }
  });
  saveToStorage();
  showToast(`✅ ${selected.length} students promoted to ${toClass}!`,'success');
  loadPromotionStudents();
  renderPromotion();
}

