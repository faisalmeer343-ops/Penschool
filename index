function renderDashboard(){
  const container=document.getElementById('contentArea');
  const students=AppData.students;
  const employees=AppData.employees;
  const activeStudents=students.filter(s=>s.status==='Currently-in').length;
  const totalDeposits=AppData.feeDeposits.reduce((sum,d)=>sum+(d.amount||0),0);
  const totalExpenses=AppData.expenditures.reduce((sum,e)=>sum+(e.grandTotal||0),0);
  const cashDeposits=AppData.feeDeposits.filter(d=>d.paymentMode==='Cash').reduce((sum,d)=>sum+(d.amount||0),0);
  const bankDeposits=AppData.feeDeposits.filter(d=>d.paymentMode!=='Cash').reduce((sum,d)=>sum+(d.amount||0),0);
  const pendingInquiries=AppData.inquiries.filter(i=>i.status==='Pending').length;

  let html=`
    <div class="card">
      <div class="card-title"><span class="prompt">&gt;&gt;&gt;</span> Dashboard <span class="badge">live</span></div>
      <div style="font-size:14px;color:var(--text-muted);">${getTodayWithMonthName()}</div>
      <div style="font-size:12px;color:var(--accent-gold);margin-top:4px;">👤 Logged in as: <strong>${currentUser}</strong> (${currentUserRole})</div>
    </div>
    <div class="dashboard-search" style="background:var(--bg-card);border:2px solid var(--accent-gold);border-radius:var(--radius);padding:14px 20px;margin-bottom:16px;box-shadow:var(--shadow);">
      <div style="font-size:14px;font-weight:900;color:var(--accent-blue);margin-bottom:8px;">🔍 Quick Search</div>
      <div style="display:flex;flex-wrap:wrap;gap:8px 12px;align-items:center;">
        <label>Search:</label>
        <input id="dashboardSearchInput" placeholder="Enter search term..." oninput="performDashboardSearch()" style="padding:6px 12px;border:1px solid var(--border-color);border-radius:4px;font-size:13px;flex:1;min-width:150px;" />
        <label>Category:</label>
        <select id="dashboardSearchCategory" onchange="performDashboardSearch()" style="padding:6px 12px;border:1px solid var(--border-color);border-radius:4px;font-size:13px;">
          ${getSearchCategoryOptions('Name')}
        </select>
        <label>Type:</label>
        <select id="dashboardSearchType" onchange="performDashboardSearch()" style="padding:6px 12px;border:1px solid var(--border-color);border-radius:4px;font-size:13px;">
          <option value="all">All</option>
          <option value="students">Students Only</option>
          <option value="employees">Employees Only</option>
          <option value="inquiries">Inquiries Only</option>
        </select>
        <button class="btn btn-secondary btn-sm" onclick="clearDashboardSearch()">Clear</button>
      </div>
      <div id="dashboardSearchResults" style="margin-top:10px;max-height:300px;overflow-y:auto;">
        <div style="padding:20px;text-align:center;color:var(--text-muted);">Enter search criteria above</div>
      </div>
    </div>
    <div class="stats-grid">
      <div class="stat-card"><div class="stat-icon">👨‍🎓</div><div class="label">Total Students</div><div class="value blue">${students.length}</div></div>
      <div class="stat-card"><div class="stat-icon">✅</div><div class="label">Active Students</div><div class="value green">${activeStudents}</div></div>
      <div class="stat-card"><div class="stat-icon">👨‍💼</div><div class="label">Total Staff</div><div class="value blue">${employees.length}</div></div>
      <div class="stat-card"><div class="stat-icon">📋</div><div class="label">Pending Inquiries</div><div class="value gold">${pendingInquiries}</div></div>
      <div class="stat-card"><div class="stat-icon">💰</div><div class="label">Fee Collected</div><div class="value green">${formatCurrency(totalDeposits)}</div></div>
      <div class="stat-card"><div class="stat-icon">💵</div><div class="label">Cash Collection</div><div class="value gold">${formatCurrency(cashDeposits)}</div></div>
      <div class="stat-card"><div class="stat-icon">🏦</div><div class="label">Bank Collection</div><div class="value blue">${formatCurrency(bankDeposits)}</div></div>
      <div class="stat-card"><div class="stat-icon">📤</div><div class="label">Expenditure</div><div class="value danger">${formatCurrency(totalExpenses)}</div></div>
      <div class="stat-card"><div class="stat-icon">📈</div><div class="label">Balance</div><div class="value gold">${formatCurrency(totalDeposits-totalExpenses)}</div></div>
    </div>
    <div class="card">
      <div class="card-title"><span class="prompt">&gt;&gt;&gt;</span> Recent Students</div>
      <div class="table-wrap"><table>
        <thead><tr><th>Admission No</th><th>Name</th><th>Father</th><th>Class</th><th>Status</th></tr></thead>
        <tbody>
  `;
  const recent=students.slice(-10).reverse();
  if(recent.length===0){
    html+=`<tr><td colspan="5" style="padding:14px;color:var(--text-muted);text-align:center;">No students added yet</td></tr>`;
  }else{
    recent.forEach(s=>{
      const statusClass=s.status==='Currently-in'?'badge-paid':'badge-pending';
      html+=`<tr><td><strong>${s.admissionNo}</strong></td><td>${s.name}</td><td>${s.fatherName}</td><td>${s.currentClass}</td><td><span class="badge-status ${statusClass}">${s.status}</span></td></tr>`;
    });
  }
  html+=`</tbody></table></div></div>`;
  container.innerHTML=html;
}

function performDashboardSearch(){
  const query=document.getElementById('dashboardSearchInput').value.toLowerCase().trim();
  const category=document.getElementById('dashboardSearchCategory').value;
  const type=document.getElementById('dashboardSearchType').value;
  const resultsDiv=document.getElementById('dashboardSearchResults');
  if(!query){
    resultsDiv.innerHTML='<div style="padding:20px;text-align:center;color:var(--text-muted);">Enter search criteria above</div>';
    return;
  }
  let studentResults=[],employeeResults=[],inquiryResults=[];
  if(type==='all'||type==='students'){
    studentResults=AppData.students.filter(s=>{
      switch(category){
        case 'Name':return s.name.toLowerCase().includes(query);
        case 'Father Name':return (s.fatherName||'').toLowerCase().includes(query);
        case 'NIC No':return (s.fatherNic||'').toLowerCase().includes(query);
        case 'Mobile No':return (s.contactNumber||'').includes(query);
        case 'Roll No':return (s.rollNo||'').toLowerCase().includes(query);
        case 'Admission No':return (s.admissionNo||'').toLowerCase().includes(query);
        default:return s.name.toLowerCase().includes(query)||(s.fatherName||'').toLowerCase().includes(query);
      }
    });
  }
  if(type==='all'||type==='employees'){
    employeeResults=AppData.employees.filter(e=>{
      switch(category){
        case 'Name':return e.name.toLowerCase().includes(query);
        case 'Mobile No':return (e.mobile||'').includes(query);
        case 'Roll No':return (e.empId||'').toLowerCase().includes(query);
        default:return e.name.toLowerCase().includes(query)||(e.empId||'').toLowerCase().includes(query);
      }
    });
  }
  if(type==='all'||type==='inquiries'){
    inquiryResults=AppData.inquiries.filter(i=>{
      switch(category){
        case 'Name':return i.name.toLowerCase().includes(query);
        case 'Father Name':return (i.fatherName||'').toLowerCase().includes(query);
        case 'Mobile No':return (i.phone||'').includes(query);
        default:return i.name.toLowerCase().includes(query)||(i.fatherName||'').toLowerCase().includes(query);
      }
    });
  }
  let html='';
  if(studentResults.length===0&&employeeResults.length===0&&inquiryResults.length===0){
    html='<div style="padding:20px;text-align:center;color:var(--text-muted);">❌ No results found for "'+query+'"</div>';
  }else{
    if(studentResults.length>0){
      html+=`<div style="font-weight:900;color:var(--accent-blue);padding:4px 0;border-bottom:1px solid var(--border-color);">👨‍🎓 Students (${studentResults.length})</div>
        <table><thead><tr><th>Admission No</th><th>Name</th><th>Father</th><th>Roll No</th><th>Class</th><th>Status</th></tr></thead><tbody>
        ${studentResults.slice(0,20).map(s=>`<tr><td><strong>${s.admissionNo}</strong></td><td>${s.name}</td><td>${s.fatherName}</td><td>${s.rollNo||'N/A'}</td><td>${s.currentClass}</td><td><span class="badge-status ${s.status==='Currently-in'?'badge-paid':'badge-pending'}">${s.status}</span></td></tr>`).join('')}
        </tbody></table>`;
    }
    if(employeeResults.length>0){
      if(studentResults.length>0) html+='<div style="margin-top:10px;"></div>';
      html+=`<div style="font-weight:900;color:var(--accent-blue);padding:4px 0;border-bottom:1px solid var(--border-color);">👨‍💼 Employees (${employeeResults.length})</div>
        <table><thead><tr><th>Employee ID</th><th>Name</th><th>Designation</th><th>Department</th><th>Status</th></tr></thead><tbody>
        ${employeeResults.slice(0,20).map(e=>`<tr><td><strong>${e.empId}</strong></td><td>${e.name}</td><td>${e.designation||'N/A'}</td><td>${e.department||'N/A'}</td><td><span class="badge-status ${e.status==='Active'?'badge-active':'badge-inactive'}">${e.status||'Active'}</span></td></tr>`).join('')}
        </tbody></table>`;
    }
    if(inquiryResults.length>0){
      if(studentResults.length>0||employeeResults.length>0) html+='<div style="margin-top:10px;"></div>';
      html+=`<div style="font-weight:900;color:var(--accent-blue);padding:4px 0;border-bottom:1px solid var(--border-color);">📋 Inquiries (${inquiryResults.length})</div>
        <table><thead><tr><th>Name</th><th>Father</th><th>Class</th><th>Phone</th><th>Status</th></tr></thead><tbody>
        ${inquiryResults.slice(0,20).map(i=>`<tr><td><strong>${i.name}</strong></td><td>${i.fatherName}</td><td>${i.currentClass}</td><td>${i.phone||'N/A'}</td><td><span class="badge-status ${i.status==='Pending'?'badge-pending':'badge-paid'}">${i.status}</span></td></tr>`).join('')}
        </tbody></table>`;
    }
  }
  resultsDiv.innerHTML=html;
}

function clearDashboardSearch(){
  document.getElementById('dashboardSearchInput').value='';
  document.getElementById('dashboardSearchCategory').value='Name';
  document.getElementById('dashboardSearchType').value='all';
  document.getElementById('dashboardSearchResults').innerHTML='<div style="padding:20px;text-align:center;color:var(--text-muted);">Enter search criteria above</div>';
}

