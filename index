function generateFeeChallan(){
  const studentId=document.getElementById('fcStudent').value;
  const display=document.getElementById('feeChallanDisplay');
  if(!studentId){showToast('⚠️ Select a student!','error');return;}
  const student=getStudent(studentId);
  if(!student) return;
  const settings=AppData.schoolSettings||{};
  const dueDate=document.getElementById('fcDueDate').value;
  const issueDate=document.getElementById('fcIssueDate').value;
  const month=document.getElementById('fcMonth').value;
  const year=document.getElementById('fcYear').value;
  const familyDiscount=parseFloat(document.getElementById('fcFamilyDiscount').value)||0;
  const feeHeads=[];
  let subtotal=0;
  document.querySelectorAll('.fee-head-name').forEach(el=>{
    const idx=parseInt(el.dataset.index);
    const name=el.value.trim();
    const amount=parseFloat(document.querySelector(`.fee-head-amount[data-index="${idx}"]`).value)||0;
    const discount=parseFloat(document.querySelector(`.fee-head-discount[data-index="${idx}"]`).value)||0;
    if(name&&amount>0){
      const headTotal=amount*(1-discount/100);
      feeHeads.push({name:name,amount:amount,discount:discount,total:headTotal});
      subtotal+=headTotal;
    }
  });
  const familyDiscountAmount=(subtotal*familyDiscount)/100;
  const total=subtotal-familyDiscountAmount;
  if(feeHeads.length===0){showToast('⚠️ Add at least one fee head!','error');return;}
  const challanId='CHL'+String(AppData.feeChallans.length+1).padStart(4,'0');
  AppData.feeChallans.push({
    id:challanId,
    studentId:studentId,
    studentName:student.name,
    admissionNo:student.admissionNo,
    className:student.currentClass,
    fatherName:student.fatherName,
    month:month,year:year,
    feeHeads:feeHeads,
    subtotal:subtotal,
    familyDiscount:familyDiscount,
    familyDiscountAmount:familyDiscountAmount,
    total:total,
    dueDate:dueDate,
    issueDate:issueDate,
    generatedDate:getTodayDateFormatted(),
    generatedTime:getCurrentTime()
  });
  AppData.transactions.push({
    studentId:studentId,
    studentName:student.name,
    admissionNo:student.admissionNo,
    amount:total,
    type:'Challan Generated - '+month+' '+year,
    date:getTodayDateFormatted(),
    time:getCurrentTime()
  });
  saveToStorage();
  const copies=['Student Copy','School Copy','Bank Copy'];
  const formattedDueDate=dueDate?formatDate(dueDate):'N/A';
  const formattedIssueDate=issueDate?formatDate(issueDate):'N/A';
  let vouchersHTML='<div class="voucher-print-area">';
  copies.forEach(copy=>{
    const qrId='qr_'+copy.replace(/\s/g,'_');
    vouchersHTML+=`
      <div class="voucher-box">
        <div class="v-header">
          <div class="v-logo">${getLogoHTML(40)}</div>
          <div class="v-school">${settings.schoolName||'SUBHANI ACADEMY SCHOOL'}</div>
          <div class="v-sub">${settings.schoolAddress||''}</div>
          <div class="v-sub">${settings.schoolPhone||''}</div>
        </div>
        <div style="text-align:center;"><span class="v-copy-type">${copy}</span></div>
        <div class="v-details">
          <div class="row"><span class="label">Challan No</span><span class="value">${challanId}</span></div>
          <div class="row"><span class="label">Admission No</span><span class="value">${student.admissionNo}</span></div>
          <div class="row"><span class="label">Class</span><span class="value">${student.currentClass}</span></div>
          <div class="row"><span class="label">Student Name</span><span class="value">${student.name}</span></div>
          <div class="row"><span class="label">Father Name</span><span class="value">${student.fatherName}</span></div>
          <div class="row"><span class="label">Month</span><span class="value">${month} ${year}</span></div>
          <div class="row"><span class="label">Issue Date</span><span class="value">${formattedIssueDate}</span></div>
          <div class="row"><span class="label">Due Date</span><span class="value">${formattedDueDate}</span></div>
          ${feeHeads.map(fh=>`<div class="row"><span class="label">${fh.name}${fh.discount>0?' ('+fh.discount+'% off)':''}</span><span class="value">${formatCurrency(fh.total)}</span></div>`).join('')}
          ${familyDiscountAmount>0?`<div class="row"><span class="label" style="color:#067d62;">Family Discount (${familyDiscount}%)</span><span class="value" style="color:#067d62;">-${formatCurrency(familyDiscountAmount)}</span></div>`:''}
        </div>
        <div class="v-total"><span>Total</span><span>${formatCurrency(total)}</span></div>
        <div class="v-qr" id="${qrId}"></div>
        <div class="v-footer">${settings.schoolName||'SUBHANI ACADEMY SCHOOL'} — Success with Wisdom</div>
      </div>
    `;
  });
  vouchersHTML+='</div>';
