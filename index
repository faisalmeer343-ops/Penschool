function generateReport(){
  const type=document.getElementById('rptType').value;
  const output=document.getElementById('reportOutput');
  const month=document.getElementById('rptMonth').value||MONTHS[new Date().getMonth()];
  const year=document.getElementById('rptYear').value||new Date().getFullYear();
  const className=document.getElementById('rptClass').value||'All';
  let text='';
  text+='═══════════════════════════════════════════════════\n';
  text+=`  📊 ${type.toUpperCase().replace(/_/g,' ')} REPORT\n`;
  text+=`  ${getTodayWithMonthName()}\n`;
  text+='═══════════════════════════════════════════════════\n\n';
  const deposits=AppData.feeDeposits;
  const filteredDeposits=className!=='All'?deposits.filter(d=>d.className===className):deposits;
  if(type==='receiptrange'){
    const fromReceipt=parseInt(document.getElementById('rptReceiptFrom').value)||0;
    const toReceipt=parseInt(document.getElementById('rptReceiptTo').value)||0;
    if(fromReceipt===0||toReceipt===0||fromReceipt>toReceipt){text+='⚠️ Please enter valid receipt number range (From <= To)\n';output.textContent=text;return;}
    const rangeDeposits=filteredDeposits.filter(d=>{const num=parseInt(d.receiptNo);return num>=fromReceipt&&num<=toReceipt;});
    const totalAmount=rangeDeposits.reduce((sum,d)=>sum+d.amount,0);
    const cashTotal=rangeDeposits.filter(d=>d.paymentMode==='Cash').reduce((sum,d)=>sum+d.amount,0);
    const bankTotal=rangeDeposits.filter(d=>d.paymentMode!=='Cash').reduce((sum,d)=>sum+d.amount,0);
    text+=`📋 Receipt Range Report\n  Receipt Numbers: ${fromReceipt} to ${toReceipt}\n  Total Deposits: ${rangeDeposits.length}\n  Total Amount: ${formatCurrency(totalAmount)}\n  💵 Cash: ${formatCurrency(cashTotal)}\n  🏦 Bank/Cheque/Online: ${formatCurrency(bankTotal)}\n\n─────────────────────────────────────────────────\n\n`;
    rangeDeposits.forEach((d,i)=>{
      text+=`${i+1}. Receipt: ${d.receiptNo} | Student: ${d.studentName} (${d.admissionNo})\n   Amount: ${formatCurrency(d.amount)} | Mode: ${d.paymentMode}\n   Date: ${d.depositDate} | Time: ${d.depositTime||'N/A'}\n   Class: ${d.className||'N/A'}\n   Month: ${d.month} ${d.year}\n\n`;
    });
    output.textContent=text;
    return;
  }
  if(type==='feesummary'){
    const fromDate=document.getElementById('rptFromDate').value||getTodayDateInput();
    const toDate=document.getElementById('rptToDate').value||getTodayDateInput();
    const fromDateObj=new Date(fromDate);const toDateObj=new Date(toDate);toDateObj.setHours(23,59,59,999);
    let summaryDeposits=AppData.feeDeposits.filter(d=>{
      if(!d.depositDate) return false;
      const parts=d.depositDate.split('/');
      if(parts.length!==3) return false;
      const dObj=new Date(parts[2],parts[1]-1,parts[0]);
      return dObj>=fromDateObj&&dObj<=toDateObj;
    });
    if(className!=='All') summaryDeposits=summaryDeposits.filter(d=>d.className===className);
    if(summaryDeposits.length===0){text+=`📊 Fee Summary Report\n  Date Range: ${formatDate(fromDate)} to ${formatDate(toDate)}\n  No fee deposits found in this date range.\n`;output.textContent=text;return;}
    let totalMonthlyFee=0,totalAnnualFee=0,totalRegistrationFee=0,totalSecurityFee=0,totalBooksFee=0,totalUniformFee=0,totalStationaryFee=0,totalOthersFee=0,grandTotal=0;
    let receiptNumbers=[];
    summaryDeposits.forEach(dep=>{
      receiptNumbers.push(dep.receiptNo);
      const challan=AppData.feeChallans.find(c=>c.studentId===dep.studentId&&c.month===dep.month&&c.year==dep.year);
      if(challan&&challan.feeHeads){
        challan.feeHeads.forEach(fh=>{
          if(fh.name==='Monthly Fee') totalMonthlyFee+=fh.total;
          else if(fh.name==='Annual Fee') totalAnnualFee+=fh.total;
          else if(fh.name==='Registration Fee') totalRegistrationFee+=fh.total;
          else if(fh.name==='Security Fee') totalSecurityFee+=fh.total;
          else if(fh.name==='Books Fee') totalBooksFee+=fh.total;
          else if(fh.name==='Uniform Fee') totalUniformFee+=fh.total;
          else if(fh.name==='Stationary Fee') totalStationaryFee+=fh.total;
          else totalOthersFee+=fh.total;
        });
        grandTotal+=challan.total;
      }else{grandTotal+=dep.amount;}
    });
    text+=`📊 FEE SUMMARY REPORT (Complete)\n  Date Range: ${formatDate(fromDate)} to ${formatDate(toDate)}\n`;
    if(className!=='All') text+=`  Class: ${className}\n`;
    text+=`  Total Transactions: ${summaryDeposits.length}\n  Receipt Numbers Included: ${receiptNumbers.join(', ')}\n\n─────────────────────────────────────────────────\n`;
    text+=`  📆 Monthly Fee Total        : ${formatCurrency(totalMonthlyFee)}\n`;
    text+=`  📅 Annual Fee Total         : ${formatCurrency(totalAnnualFee)}\n`;
    text+=`  📄 Registration Fee Total   : ${formatCurrency(totalRegistrationFee)}\n`;
    text+=`  🔒 Security Fee Total       : ${formatCurrency(totalSecurityFee)}\n`;
    text+=`  📚 Books Fee Total          : ${formatCurrency(totalBooksFee)}\n`;
    text+=`  👕 Uniform Fee Total        : ${formatCurrency(totalUniformFee)}\n`;
    text+=`  ✏️ Stationary Fee Total     : ${formatCurrency(totalStationaryFee)}\n`;
    text+=`  📦 Others Fee Total         : ${formatCurrency(totalOthersFee)}\n`;
    text+=`─────────────────────────────────────────────────\n  💰 GRAND TOTAL              : ${formatCurrency(grandTotal)}\n─────────────────────────────────────────────────\n\n`;
    text+=`📋 DETAILED ENTRIES:\n─────────────────────────────────────────────────\n`;
    summaryDeposits.forEach((d,i)=>{
      text+=`${i+1}. Receipt: ${d.receiptNo} | Student: ${d.studentName} (${d.admissionNo})\n   Amount: ${formatCurrency(d.amount)} | Mode: ${d.paymentMode}\n   Date: ${d.depositDate} | Time: ${d.depositTime||'N/A'}\n   Class: ${d.className||'N/A'} | Month: ${d.month} ${d.year}\n   ───────────────────────────\n`;
    });
    output.textContent=text;
    return;
  }
  switch(type){
    case 'cash':
      const cashDeposits=filteredDeposits.filter(d=>d.paymentMode==='Cash');
      const totalCash=cashDeposits.reduce((sum,d)=>sum+d.amount,0);
      text+=`💵 Cash Report\nTotal Cash Deposits: ${formatCurrency(totalCash)}\nTotal Transactions: ${cashDeposits.length}\n\n`;
      cashDeposits.forEach((d,i)=>{text+=`${i+1}. ${d.studentName} (${d.admissionNo})\n   Amount: ${formatCurrency(d.amount)} | Date: ${d.depositDate}\n   Class: ${d.className} | Month: ${d.month} ${d.year}\n\n`;});
      break;
    case 'bank':
      const bankDeposits=filteredDeposits.filter(d=>d.paymentMode!=='Cash');
      const totalBank=bankDeposits.reduce((sum,d)=>sum+d.amount,0);
      text+=`🏦 Bank Report\nTotal Bank Deposits: ${formatCurrency(totalBank)}\nTotal Transactions: ${bankDeposits.length}\n\n`;
      bankDeposits.forEach((d,i)=>{text+=`${i+1}. ${d.studentName} (${d.admissionNo})\n   Amount: ${formatCurrency(d.amount)} | Mode: ${d.paymentMode}\n   Date: ${d.depositDate} | Class: ${d.className}\n\n`;});
      break;
    case 'arrears':
      text+=`⚠️ Fee Arrears Report - ${month} ${year}\n`;
      const arrearsStudents=[];
      AppData.students.forEach(s=>{
        if(className==='All'||s.currentClass===className){
          const fees=AppData.feeChallans.filter(c=>c.studentId===s.id&&c.month===month&&c.year==year);
          const totalDue=fees.reduce((sum,f)=>sum+(f.total||0),0);
          const paid=AppData.feeDeposits.filter(d=>d.studentId===s.id&&d.month===month&&d.year==year).reduce((sum,d)=>sum+d.amount,0);
          const balance=totalDue-paid;
          if(balance>0){arrearsStudents.push({student:s,balance:balance});}
        }
      });
      text+=`Total Students with Arrears: ${arrearsStudents.length}\n\n`;
      arrearsStudents.forEach((a,i)=>{text+=`${i+1}. ${a.student.name} (${a.student.admissionNo})\n   Class: ${a.student.currentClass}\n   Arrears: ${formatCurrency(a.balance)}\n\n`;});
      break;
    case 'monthlyfee':
      text+=`📆 Monthly Fee Report - ${month} ${year}\n`;
      const monthlyDeposits=filteredDeposits.filter(d=>d.month===month&&d.year==year);
      const totalMonthly=monthlyDeposits.reduce((sum,d)=>sum+d.amount,0);
      text+=`Total Collected: ${formatCurrency(totalMonthly)}\nTotal Students: ${monthlyDeposits.length}\n\n`;
      monthlyDeposits.forEach((d,i)=>{text+=`${i+1}. ${d.studentName} (${d.admissionNo})\n   Class: ${d.className||'N/A'}\n   Amount: ${formatCurrency(d.amount)} | Mode: ${d.paymentMode}\n   Date: ${d.paymentDate||d.depositDate}\n\n`;});
      break;
    case 'attendance':
      const attFromDate=document.getElementById('rptFromDate').value||getTodayDateInput();
      const attToDate=document.getElementById('rptToDate').value||getTodayDateInput();
      const attFrom=formatDate(attFromDate);const attTo=formatDate(attToDate);
      let attRecords=AppData.attendance||[];
      attRecords=attRecords.filter(r=>{
        const parts=r.date.split('/');
        if(parts.length!==3) return false;
        const dObj=new Date(parts[2],parts[1]-1,parts[0]);
        const fromObj=new Date(attFromDate);const toObj=new Date(attToDate);
        return dObj>=fromObj&&dObj<=toObj;
      });
      if(className!=='All') attRecords=attRecords.filter(r=>r.className===className);
      text+=`✅ Attendance Report\n  Date Range: ${attFrom} to ${attTo}\n  Class: ${className}\n  Total Records: ${attRecords.length}\n\n`;
      const present=attRecords.filter(r=>r.status==='Present').length;
      const absent=attRecords.filter(r=>r.status==='Absent').length;
      const leave=attRecords.filter(r=>r.status==='Leave').length;
      text+=`  ✅ Present: ${present}\n  ❌ Absent: ${absent}\n  📋 Leave: ${leave}\n\n─────────────────────────────────────────────────\n\n`;
      attRecords.forEach((r,i)=>{text+=`${i+1}. ${r.studentName} (${r.admissionNo})\n   Class: ${r.className} | Date: ${r.date}\n   Status: ${r.status} | Time: ${r.time||'N/A'}\n\n`;});
      break;
  }
  text+='═══════════════════════════════════════════════════\n';
  output.textContent=text;
}

