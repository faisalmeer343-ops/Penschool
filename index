<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<title>SUBHANI ACADEMY SCHOOL - Complete Management System</title>
<script src="https://cdnjs.cloudflare.com/ajax/libs/xlsx/0.18.5/xlsx.full.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/qrcodejs@1.0.0/qrcode.min.js"></script>
<style>
/* ===== RESET & ROOT ===== */
*{margin:0;padding:0;box-sizing:border-box;}
:root{
  --bg-primary:#EAEDED;--bg-card:#ffffff;--border-color:#d5d9dd;
  --text-primary:#131921;--text-secondary:#1a202c;--text-muted:#565959;
  --accent-blue:#131921;--accent-gold:#ff9900;--accent-green:#067d62;
  --accent-red:#b12704;--accent-teal:#007185;--sidebar-bg:#131921;
  --sidebar-hover:#1a2530;--sidebar-active:#ff9900;--radius:6px;
  --shadow:0 2px 8px rgba(0,0,0,0.08);--shadow-hover:0 4px 16px rgba(0,0,0,0.12);
  --font-family:'Segoe UI',Arial,Helvetica,sans-serif;
}
body{font-family:var(--font-family);background:var(--bg-primary);min-height:100vh;color:var(--text-primary);}

/* ===== LOGIN ===== */
#loginScreen{display:flex;justify-content:center;align-items:center;min-height:100vh;width:100%;background:linear-gradient(135deg,#131921,#1a2530);padding:20px;}
.login-box{background:#fff;padding:40px 50px;border-radius:8px;box-shadow:0 8px 40px rgba(0,0,0,0.5);width:100%;max-width:440px;text-align:center;}
.login-box .login-logo{width:90px;height:90px;border-radius:50%;border:3px solid var(--accent-gold);overflow:hidden;margin:0 auto 12px;display:flex;align-items:center;justify-content:center;background:#f7fafc;font-size:40px;}
.login-box .login-logo img{width:100%;height:100%;object-fit:cover;}
.login-box h1{color:var(--accent-blue);font-size:22px;letter-spacing:1px;line-height:1.3;}
.login-box .subtitle{color:var(--accent-gold);font-weight:900;letter-spacing:3px;font-size:13px;margin-top:4px;}
.login-box .tagline{color:var(--text-muted);font-size:11px;margin-top:4px;}
.login-box .form-group{margin-top:16px;text-align:left;}
.login-box .form-group label{display:block;font-weight:600;margin-bottom:4px;color:var(--text-secondary);font-size:14px;}
.login-box .form-group input{width:100%;padding:10px 14px;border:2px solid var(--border-color);border-radius:var(--radius);font-size:14px;transition:all 0.3s;}
.login-box .form-group input:focus{outline:none;border-color:var(--accent-gold);box-shadow:0 0 0 3px rgba(255,153,0,0.15);}
.login-btn{width:100%;padding:12px;background:var(--accent-gold);color:#fff;border:none;border-radius:var(--radius);font-size:16px;font-weight:700;cursor:pointer;margin-top:20px;transition:all 0.3s;}
.login-btn:hover{background:#e68a00;transform:translateY(-1px);box-shadow:var(--shadow-hover);}
.login-error{color:var(--accent-red);font-size:13px;margin-top:8px;display:none;}
.login-box .default-msg{margin-top:12px;color:var(--text-muted);font-size:12px;}

/* ===== MAIN APP ===== */
#appContainer{display:none;width:100%;min-height:100vh;background:var(--bg-primary);}

/* ===== TOP BAR ===== */
.top-bar{background:#131921;padding:8px 24px;display:flex;justify-content:space-between;align-items:center;flex-wrap:wrap;gap:10px;border-bottom:2px solid var(--accent-gold);position:sticky;top:0;z-index:100;box-shadow:0 2px 8px rgba(0,0,0,0.3);}
.top-bar .logo-area{display:flex;align-items:center;gap:14px;}
.top-bar .logo-box{display:flex;align-items:center;gap:12px;}
.top-bar .logo-box .logo-img{width:50px;height:50px;border-radius:50%;border:2px solid var(--accent-gold);overflow:hidden;flex-shrink:0;display:flex;align-items:center;justify-content:center;background:#f7fafc;font-size:24px;}
.top-bar .logo-box .logo-img img{width:100%;height:100%;object-fit:cover;}
.top-bar .logo-text .line1{font-size:14px;font-weight:900;color:var(--accent-gold);letter-spacing:1px;}
.top-bar .logo-text .line2{font-size:10px;color:#ffffff;letter-spacing:1px;}
.top-bar .logo-text .line3{font-size:9px;color:#8899a6;letter-spacing:1px;}
.top-bar .title{font-size:14px;font-weight:900;color:#ffffff;}
.top-bar .title .py{color:var(--accent-gold);}
.top-bar .title small{font-size:9px;color:#8899a6;font-weight:400;display:block;}
.top-bar .user-info{display:flex;align-items:center;gap:12px;color:#ffffff;}
.top-bar .user-info .username{font-weight:600;}
.top-bar .user-info .user-role{font-size:10px;color:var(--accent-gold);background:rgba(255,153,0,0.15);padding:2px 10px;border-radius:10px;}
.top-bar .user-info .btn-danger{background:var(--accent-red);color:#fff;}
.top-bar .user-info .btn-danger:hover{background:#d12b0a;}

/* ===== BUTTONS ===== */
.btn{padding:6px 16px;border:none;border-radius:var(--radius);font-weight:600;font-size:13px;cursor:pointer;transition:all 0.2s;display:inline-flex;align-items:center;gap:5px;font-family:var(--font-family);}
.btn:hover{transform:translateY(-1px);box-shadow:var(--shadow-hover);}
.btn-danger{background:var(--accent-red);color:#fff;}.btn-danger:hover{background:#d12b0a;}
.btn-primary{background:var(--accent-blue);color:#fff;}.btn-primary:hover{background:#1a2530;}
.btn-success{background:var(--accent-green);color:#fff;}.btn-success:hover{background:#055a45;}
.btn-warning{background:var(--accent-gold);color:#fff;}.btn-warning:hover{background:#e68a00;}
.btn-info{background:var(--accent-teal);color:#fff;}.btn-info:hover{background:#005566;}
.btn-secondary{background:#565959;color:#fff;}.btn-secondary:hover{background:#6f7373;}
.btn-sm{padding:3px 10px;font-size:11px;}
.btn-xs{padding:2px 8px;font-size:10px;}

/* ===== SIDEBAR ===== */
.main-container{display:flex;min-height:calc(100vh - 66px);}
.sidebar{width:240px;background:var(--sidebar-bg);padding:8px 0;flex-shrink:0;border-right:2px solid var(--accent-gold);overflow-y:auto;max-height:calc(100vh - 66px);}
.sidebar .section-label{font-size:10px;font-weight:900;text-transform:uppercase;color:var(--accent-gold);padding:10px 16px 4px;letter-spacing:2px;border-top:1px solid rgba(255,255,255,0.05);margin-top:4px;}
.sidebar .section-label:first-child{border-top:none;margin-top:0;}
.sidebar a{display:flex;align-items:center;gap:10px;padding:9px 18px;color:#ffffff;font-size:13px;font-weight:500;text-decoration:none;transition:all 0.3s ease;border-left:3px solid transparent;cursor:pointer;font-family:var(--font-family);}
.sidebar a:hover{background:var(--sidebar-hover);color:var(--accent-gold);}
.sidebar a.active{background:var(--sidebar-hover);color:var(--accent-gold);border-left-color:var(--accent-gold);}
.sidebar a .emoji{font-size:15px;}

/* ===== CONTENT ===== */
.content{flex:1;padding:18px 24px;overflow-x:auto;background:var(--bg-primary);}

/* ===== CARDS ===== */
.card{background:var(--bg-card);border:1px solid var(--border-color);border-radius:var(--radius);padding:18px 22px;margin-bottom:16px;box-shadow:var(--shadow);}
.card-title{font-size:18px;font-weight:900;margin-bottom:12px;color:var(--accent-blue);display:flex;align-items:center;gap:10px;border-bottom:2px solid var(--border-color);padding-bottom:8px;font-family:var(--font-family);flex-wrap:wrap;}
.card-title .badge{background:var(--accent-gold);color:#fff;font-size:10px;padding:2px 12px;border-radius:12px;font-weight:900;}
.card-title .prompt{color:var(--accent-gold);}

/* ===== FORM ROWS ===== */
.form-row{display:flex;flex-wrap:wrap;gap:6px 12px;align-items:center;margin-bottom:8px;padding:6px 10px;background:var(--bg-primary);border:1px solid var(--border-color);border-radius:4px;}
.form-row label{font-weight:600;font-size:13px;color:var(--accent-blue);min-width:50px;}
.form-row input,.form-row select,.form-row textarea{padding:6px 12px;background:var(--bg-card);border:1px solid var(--border-color);border-radius:4px;font-size:13px;color:var(--text-secondary);flex:1;min-width:80px;transition:all 0.2s;font-family:var(--font-family);}
.form-row input:focus,.form-row select:focus,.form-row textarea:focus{outline:none;border-color:var(--accent-gold);box-shadow:0 0 0 2px rgba(255,153,0,0.15);}

/* ===== STUDENT SEARCH SELECT ===== */
.student-search-select{position:relative;flex:1;min-width:200px;}
.student-search-select input{width:100%;padding:6px 12px;border:1px solid var(--border-color);border-radius:4px;font-size:13px;background:var(--bg-card);font-family:var(--font-family);}
.student-search-select input:focus{outline:none;border-color:var(--accent-gold);box-shadow:0 0 0 2px rgba(255,153,0,0.15);}
.student-search-select .dropdown{display:none;position:absolute;top:100%;left:0;right:0;background:var(--bg-card);border:1px solid var(--border-color);border-radius:4px;max-height:200px;overflow-y:auto;z-index:50;box-shadow:var(--shadow-hover);}
.student-search-select .dropdown.show{display:block;}
.student-search-select .dropdown .item{padding:6px 12px;cursor:pointer;border-bottom:1px solid var(--border-color);font-size:13px;}
.student-search-select .dropdown .item:hover{background:var(--bg-primary);}
.student-search-select .dropdown .item .adm-no{color:var(--accent-gold);font-weight:600;}

/* ===== STATS GRID ===== */
.stats-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(150px,1fr));gap:12px;margin-bottom:16px;}
.stat-card{background:var(--bg-card);border:1px solid var(--border-color);border-radius:var(--radius);padding:12px 16px;text-align:center;transition:all 0.2s;box-shadow:var(--shadow);}
.stat-card:hover{border-color:var(--accent-gold);transform:translateY(-2px);box-shadow:var(--shadow-hover);}
.stat-card .stat-icon{font-size:24px;margin-bottom:2px;}
.stat-card .label{font-size:11px;color:var(--text-muted);font-weight:600;text-transform:uppercase;letter-spacing:0.5px;}
.stat-card .value{font-size:22px;font-weight:800;margin-top:2px;}
.stat-card .value.gold{color:var(--accent-gold);}
.stat-card .value.green{color:var(--accent-green);}
.stat-card .value.blue{color:var(--accent-blue);}
.stat-card .value.danger{color:var(--accent-red);}

/* ===== TABLES ===== */
.table-wrap{overflow-x:auto;max-height:500px;overflow-y:auto;border:1px solid var(--border-color);border-radius:var(--radius);background:var(--bg-card);}
table{width:100%;border-collapse:collapse;font-size:13px;min-width:500px;font-family:var(--font-family);}
table th{background:#131921;color:#ffffff;padding:8px 12px;text-align:left;position:sticky;top:0;z-index:5;white-space:nowrap;font-weight:900;font-size:11px;text-transform:uppercase;letter-spacing:0.5px;border:1px solid #232f3e;}
table td{padding:6px 12px;border:1px solid var(--border-color);text-align:left;vertical-align:middle;color:var(--text-secondary);}
table tr:nth-child(even) td{background:var(--bg-primary);}
table tr:hover td{background:rgba(255,153,0,0.05);}

/* ===== SEARCH BAR ===== */
.search-bar{display:flex;flex-wrap:wrap;gap:8px 12px;align-items:center;padding:6px 12px;background:var(--bg-primary);border:1px solid var(--border-color);border-radius:4px;margin-bottom:10px;}
.search-bar input,.search-bar select{padding:5px 10px;border:1px solid var(--border-color);border-radius:4px;font-size:13px;background:var(--bg-card);font-family:var(--font-family);}
.search-bar input:focus,.search-bar select:focus{outline:none;border-color:var(--accent-gold);box-shadow:0 0 0 2px rgba(255,153,0,0.15);}
.search-bar label{font-weight:600;font-size:12px;color:var(--text-muted);}

/* ===== BADGES ===== */
.badge-status{padding:2px 10px;border-radius:12px;font-size:10px;font-weight:900;display:inline-block;border:1px solid transparent;}
.badge-paid{background:rgba(6,125,98,0.15);color:var(--accent-green);border-color:rgba(6,125,98,0.3);}
.badge-pending{background:rgba(177,39,4,0.15);color:var(--accent-red);border-color:rgba(177,39,4,0.3);}
.badge-active{background:rgba(6,125,98,0.15);color:var(--accent-green);border-color:rgba(6,125,98,0.3);}
.badge-inactive{background:rgba(177,39,4,0.15);color:var(--accent-red);border-color:rgba(177,39,4,0.3);}

/* ===== TOAST ===== */
.toast{position:fixed;bottom:20px;right:20px;background:var(--bg-card);border:1px solid var(--border-color);color:var(--text-secondary);padding:12px 24px;border-radius:var(--radius);box-shadow:var(--shadow-hover);font-weight:600;z-index:9999;animation:slideUp 0.3s ease;display:none;min-width:180px;font-size:14px;border-left:4px solid var(--accent-green);max-width:90vw;font-family:var(--font-family);}
.toast.show{display:block;}
.toast.error{border-left-color:var(--accent-red);}
.toast.success{border-left-color:var(--accent-green);}
.toast.info{border-left-color:var(--accent-gold);}
@keyframes slideUp{from{opacity:0;transform:translateY(20px);}to{opacity:1;transform:translateY(0);}}

/* ===== MODAL ===== */
.modal-overlay{display:none;position:fixed;top:0;left:0;width:100%;height:100%;background:rgba(0,0,0,0.5);backdrop-filter:blur(4px);z-index:1000;justify-content:center;align-items:center;}
.modal-overlay.show{display:flex;}
.modal-box{background:var(--bg-card);border-radius:var(--radius);padding:25px 30px;max-width:90%;max-height:90vh;overflow-y:auto;box-shadow:var(--shadow-hover);border:2px solid var(--accent-gold);min-width:400px;}
.modal-box .modal-header{display:flex;justify-content:space-between;align-items:center;border-bottom:2px solid var(--border-color);padding-bottom:10px;margin-bottom:15px;}
.modal-box .modal-header h2{color:var(--accent-blue);font-size:20px;font-weight:900;}
.modal-box .modal-close{background:var(--accent-red);color:#fff;border:none;border-radius:50%;width:30px;height:30px;font-size:16px;cursor:pointer;display:flex;align-items:center;justify-content:center;}
.modal-box .modal-close:hover{background:#d12b0a;}

/* ===== ADMISSION FORM GRID ===== */
.admission-form-grid{display:grid;grid-template-columns:1fr 1fr 1fr;gap:8px 16px;}
.admission-form-grid .full-width{grid-column:1 / -1;}
.admission-form-grid label{font-weight:900;font-size:13px;color:var(--accent-blue);display:block;margin-bottom:2px;}
.admission-form-grid input,.admission-form-grid select,.admission-form-grid textarea{padding:6px 12px;background:var(--bg-card);border:1px solid var(--border-color);border-radius:4px;font-size:13px;color:var(--text-secondary);width:100%;transition:all 0.2s;font-family:var(--font-family);}
.admission-form-grid input:focus,.admission-form-grid select:focus,.admission-form-grid textarea:focus{outline:none;border-color:var(--accent-gold);box-shadow:0 0 0 2px rgba(255,153,0,0.15);}
.admission-form-grid input[readonly]{background:#f7fafc;cursor:not-allowed;}

/* ===== FEE VOUCHER ===== */
.voucher-print-area{display:grid;grid-template-columns:1fr 1fr 1fr;gap:12px;margin-top:10px;}
.voucher-box{background:#fff;border:2px solid #131921;border-radius:6px;padding:12px 14px;font-family:Arial,Helvetica,sans-serif;font-size:11px;max-width:340px;margin:0 auto;box-shadow:0 2px 8px rgba(0,0,0,0.08);page-break-inside:avoid;}
.voucher-box .v-header{text-align:center;border-bottom:2px solid #131921;padding-bottom:6px;margin-bottom:6px;}
.voucher-box .v-header .v-logo{width:40px;height:40px;border-radius:50%;border:2px solid var(--accent-gold);overflow:hidden;margin:0 auto 4px;display:flex;align-items:center;justify-content:center;background:#f7fafc;font-size:20px;}
.voucher-box .v-header .v-logo img{width:100%;height:100%;object-fit:cover;}
.voucher-box .v-header .v-school{font-size:12px;font-weight:900;color:#131921;}
.voucher-box .v-header .v-sub{font-size:9px;color:#565959;}
.voucher-box .v-copy-type{text-align:center;font-size:9px;font-weight:900;color:#fff;letter-spacing:2px;background:#131921;padding:2px 8px;border-radius:3px;display:inline-block;margin-bottom:4px;}
.voucher-box .v-details{font-size:10px;line-height:1.5;}
.voucher-box .v-details .row{display:flex;justify-content:space-between;padding:2px 0;border-bottom:1px dashed #e2e8f0;}
.voucher-box .v-details .label{font-weight:900;color:#131921;}
.voucher-box .v-details .value{font-weight:600;color:#1a202c;}
.voucher-box .v-total{background:#131921;color:var(--accent-gold);padding:4px 8px;border-radius:4px;display:flex;justify-content:space-between;font-weight:900;font-size:12px;margin-top:4px;}
.voucher-box .v-footer{text-align:center;font-size:8px;color:#565959;border-top:1px solid #131921;padding-top:4px;margin-top:4px;}
.voucher-box .v-qr{text-align:center;margin-top:6px;padding-top:4px;border-top:1px dashed #e2e8f0;}
.voucher-box .v-qr canvas,.voucher-box .v-qr img{width:60px !important;height:60px !important;}

/* ===== CERTIFICATES ===== */
.certificate-wrapper{background:#fff;border:4px double #131921;border-radius:8px;padding:25px 30px;max-width:850px;margin:10px auto;font-family:Arial,Helvetica,sans-serif;}
.certificate-wrapper .cert-header{text-align:center;border-bottom:2px solid #131921;padding-bottom:10px;margin-bottom:12px;}
.certificate-wrapper .cert-logo{width:70px;height:70px;border-radius:50%;border:3px solid var(--accent-gold);overflow:hidden;margin:0 auto 6px;display:flex;align-items:center;justify-content:center;background:#f7fafc;font-size:32px;}
.certificate-wrapper .cert-logo img{width:100%;height:100%;object-fit:cover;}
.certificate-wrapper .school-name{font-size:20px;font-weight:900;color:#131921;letter-spacing:2px;}
.certificate-wrapper .school-sub{font-size:13px;color:#565959;}
.certificate-wrapper .motto{font-size:12px;color:var(--accent-gold);font-style:italic;font-weight:900;}
.certificate-wrapper .cert-title{background:#131921;color:var(--accent-gold);padding:6px 24px;font-size:18px;font-weight:900;text-align:center;border-radius:4px;letter-spacing:3px;margin-bottom:12px;}
.certificate-wrapper .cert-body .field{display:flex;padding:3px 0;border-bottom:1px dashed #e2e8f0;font-size:13px;align-items:center;}
.certificate-wrapper .cert-body .label{font-weight:900;color:#131921;min-width:160px;font-size:12px;}
.certificate-wrapper .cert-body .value{font-weight:600;color:#1a202c;border-bottom:2px solid #cbd5e0;padding:0 4px;flex:1;}
.certificate-wrapper .cert-body .remarks-box{padding:10px 0;font-size:13px;color:#4a5568;border-top:1px solid #e2e8f0;margin-top:8px;}
.certificate-wrapper .cert-student-photo{width:100px;height:110px;border:3px solid #131921;border-radius:6px;overflow:hidden;flex-shrink:0;display:flex;align-items:center;justify-content:center;background:#f7fafc;margin-left:10px;font-size:32px;}
.certificate-wrapper .cert-student-photo img{width:100%;height:100%;object-fit:cover;}
.certificate-wrapper .cert-footer{display:flex;justify-content:space-between;margin-top:16px;padding-top:12px;border-top:3px double #131921;flex-wrap:wrap;gap:10px;}
.certificate-wrapper .signature{text-align:center;flex:1;min-width:120px;}
.certificate-wrapper .signature .line{width:130px;border-top:3px solid #1a202c;margin:4px auto;}
.certificate-wrapper .signature .label{font-weight:900;color:#131921;font-size:11px;text-transform:uppercase;letter-spacing:0.5px;}

/* ===== PAYSLIP ===== */
.payslip-wrapper{background:#fff;border:2px solid #131921;border-radius:8px;padding:20px;max-width:1100px;margin:10px auto;font-family:Arial,Helvetica,sans-serif;}
.payslip-wrapper .ps-header{display:flex;align-items:center;gap:16px;border-bottom:2px solid #131921;padding-bottom:8px;margin-bottom:10px;}
.payslip-wrapper .ps-logo{width:60px;height:60px;border-radius:50%;border:2px solid var(--accent-gold);overflow:hidden;flex-shrink:0;display:flex;align-items:center;justify-content:center;background:#f7fafc;font-size:24px;}
.payslip-wrapper .ps-logo img{width:100%;height:100%;object-fit:cover;}
.payslip-wrapper .ps-title h1{font-size:18px;color:#131921;margin:0;}
.payslip-wrapper .ps-title .subtitle{font-size:11px;color:#565959;}
.payslip-wrapper .ps-badge{background:var(--accent-gold);color:#fff;padding:4px 20px;font-size:14px;font-weight:900;letter-spacing:3px;border-radius:4px;display:inline-block;margin-bottom:10px;}
.payslip-wrapper .ps-employee{display:flex;gap:14px;margin-bottom:10px;padding:8px 12px;background:#f7fafc;border-radius:4px;}
.payslip-wrapper .ps-photo{width:60px;height:60px;border-radius:50%;border:2px solid #131921;overflow:hidden;flex-shrink:0;display:flex;align-items:center;justify-content:center;background:#f7fafc;font-size:24px;}
.payslip-wrapper .ps-photo img{width:100%;height:100%;object-fit:cover;}
.payslip-wrapper .ps-details{flex:1;font-size:12px;}
.payslip-wrapper .ps-details .row{display:flex;justify-content:space-between;padding:2px 0;border-bottom:1px dashed #e2e8f0;}
.payslip-wrapper .ps-details .label{font-weight:900;color:#131921;}
.payslip-wrapper .ps-table{width:100%;border-collapse:collapse;font-size:10px;margin-bottom:8px;}
.payslip-wrapper .ps-table th{background:#131921;color:#fff;padding:4px 6px;text-align:center;font-size:9px;border:1px solid #232f3e;white-space:nowrap;}
.payslip-wrapper .ps-table td{padding:4px 6px;border:1px solid #e2e8f0;text-align:center;font-size:9px;}
.payslip-wrapper .ps-table .credit-row{background:#f0fdf4;}
