function loadEmployeePaySlip(){
  const employeeId=document.getElementById('psEmployee').value;
  if(!employeeId) return;
  const employee=getEmployee(employeeId);
  if(!employee) return;
  document.getElementById('psBasic').value=employee.salary||0;
  if(employee.allowances){
    document.getElementById('psAttendanceAllowance').value=employee.allowances.attendance||0;
    document.getElementById('psSpokenAllowance').value=employee.allowances.spoken||0;
    document.getElementById('psProductivityAllowance').value=employee.allowances.productivity||0;
    document.getElementById('psStayBackAllowance').value=employee.allowances.stayBack||0;
    document.getElementById('psSecurityDeduction').value=employee.allowances.security||0;
    document.getElementById('psAdvancedPaid').value=employee.allowances.advanced||0;
    document.getElementById('psAbsentee').value=employee.allowances.absentee||0;
  }
  calculatePaySlip();
}

function calculatePaySlip(){
  const basic=parseFloat(document.getElementById('psBasic').value)||0;
  const attendance=parseFloat(document.getElementById('psAttendanceAllowance').value)||0;
  const spoken=parseFloat(document.getElementById('psSpokenAllowance').value)||0;
  const productivity=parseFloat(document.getElementById('psProductivityAllowance').value)||0;
  const stayBack=parseFloat(document.getElementById('psStayBackAllowance').value)||0;
  const security=parseFloat(document.getElementById('psSecurityDeduction').value)||0;
  const advanced=parseFloat(document.getElementById('psAdvancedPaid').value)||0;
  const absentee=parseFloat(document.getElementById('psAbsentee').value)||0;
  const totalCredit=basic+attendance+spoken+productivity+stayBack;
  const totalDebit=security+advanced+absentee;
  const netSalary=totalCredit-totalDebit;
  document.getElementById('psTotalCredit').value=totalCredit.toFixed(2);
  document.getElementById('psTotalDebit').value=totalDebit.toFixed(2);
  document.getElementById('psNetSalary').value=netSalary.toFixed(2);
}

