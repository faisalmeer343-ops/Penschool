function saveFeeDeposit(){
  const studentId=document.getElementById('fdStudent').value;
  if(!studentId){showToast('⚠️ Select a student!','error');return;}
  const student=getStudent(studentId);
  if(!student) return;
  const amount=parseFloat(document.getElementById('fdAmount').value)||0;
  if(amount<=0){showToast('⚠️ Enter a valid amount!','error');return;}
  let receiptNoInput=document.getElementById('fdReceiptNo').value.trim();
  let receiptNo;
  if(!receiptNoInput){receiptNo=getNextReceiptNumber();}
  else{receiptNo=parseInt(receiptNoInput);if(isNaN(receiptNo)||receiptNo<=0){showToast('⚠️ Enter valid receipt number!','error');return;}}
  const existingDeposit=AppData.feeDeposits.find(d=>d.receiptNo==receiptNo);
  if(existingDeposit&&!editingDepositId){showToast('⚠️ Receipt number '+receiptNo+' already exists!','error');return;}
  if(editingDepositId){
    const duplicate=AppData.feeDeposits.find(d=>d.receiptNo==receiptNo&&d.id!==editingDepositId);
    if(duplicate){showToast('⚠️ Receipt number '+receiptNo+' already exists!','error');return;}
  }
  if(receiptNo>AppData.receiptCounter) AppData.receiptCounter=receiptNo;
  const depositData={
    studentId:studentId,
    admissionNo:student.admissionNo,
    studentName:student.name,
    className:student.currentClass,
    amount:amount,
    paymentMode:document.getElementById('fdPaymentMode').value,
    paymentDate:document.getElementById('fdPaymentDate').value,
    month:document.getElementById('fdMonth').value,
    year:document.getElementById('fdYear').value,
    receiptNo:receiptNo,
    depositDate:getTodayDateFormatted(),
    depositTime:getCurrentTime()
  };
  if(editingDepositId){
    const idx=AppData.feeDeposits.findIndex(d=>d.id===editingDepositId);
    if(idx!==-1){AppData.feeDeposits[idx]={...AppData.feeDeposits[idx],...depositData};}
    editingDepositId=null;
    showToast(`✅ Fee deposit updated!`,'success');
  }else{
    AppData.feeDeposits.push({id:'DEP'+String(AppData.feeDeposits.length+1).padStart(4,'0'),...depositData});
    AppData.transactions.push({
      studentId:studentId,
      studentName:student.name,
      admissionNo:student.admissionNo,
      amount:amount,
      type:'Fee Deposit - '+depositData.month+' '+depositData.year+' ('+depositData.paymentMode+')',
      date:getTodayDateFormatted(),
      time:getCurrentTime(),
      receiptNo:receiptNo
    });
    showToast(`✅ Fee deposited: ${formatCurrency(amount)} for ${student.name}`,'success');
  }
  saveToStorage();
  loadFeeDeposits();
  document.getElementById('fdStudent').value='';
  document.getElementById('fdStudent_search').value='';
  document.getElementById('fdAdmissionNo').value='';
  document.getElementById('fdName').value='';
  document.getElementById('fdClass').value='';
  document.getElementById('fdAmount').value='0';
  document.getElementById('fdPaymentDate').value=getTodayDateInput();
  document.getElementById('fdReceiptNo').value=getCurrentReceiptNumberForDisplay();
}

