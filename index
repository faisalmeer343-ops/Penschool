function loadAttendanceStudents(){
  const className=document.getElementById('attClass').value;
  const date=document.getElementById('attDate').value;
  const container=document.getElementById('attendanceList');
  if(!className){
    container.innerHTML='<p style="color:var(--text-muted);text-align:center;padding:20px;">Select a class to load students</p>';
    return;
  }
  const students=AppData.students.filter(s=>s.currentClass===className&&s.status==='Currently-in');
  if(students.length===0){
    container.innerHTML=`<p style="color:var(--text-muted);text-align:center;padding:20px;">No active students in ${className}</p>`;
    return;
  }
  const formattedDate=formatDate(date);
  const existingRecords=(AppData.attendance||[]).filter(r=>r.date===formattedDate&&r.className===className);
  let html=`<div style="font-weight:900;color:var(--accent-blue);padding:8px;border-bottom:2px solid var(--accent-blue);">Total Students: ${students.length} | Date: ${formattedDate}</div>`;
  html+=`<div class="attendance-grid">`;
  students.forEach(s=>{
    const record=existingRecords.find(r=>r.studentId===s.id);
    const status=record?record.status:'Present';
    const photo=s.photo?`<img src="${s.photo}" alt="Photo" />`:'<span>👤</span>';
    html+=`
      <div class="attendance-student-card" data-student-id="${s.id}">
        <div class="att-photo">${photo}</div>
        <div class="att-info">
          <div class="name">${s.name}</div>
          <div class="adm">${s.admissionNo} | ${s.currentClass}</div>
        </div>
        <div class="att-actions">
          <button onclick="setAttendance('${s.id}','Present','${className}','${formattedDate}')" style="background:#067d62;color:#fff;${status==='Present'?'opacity:1;':'opacity:0.5;'}">✅</button>
          <button onclick="setAttendance('${s.id}','Absent','${className}','${formattedDate}')" style="background:#b12704;color:#fff;${status==='Absent'?'opacity:1;':'opacity:0.5;'}">❌</button>
          <button onclick="setAttendance('${s.id}','Leave','${className}','${formattedDate}')" style="background:#ff9900;color:#fff;${status==='Leave'?'opacity:1;':'opacity:0.5;'}">📋</button>
        </div>
      </div>
    `;
  });
  html+=`</div>`;
  container.innerHTML=html;
}

function setAttendance(studentId,status,className,formattedDate){
  const student=getStudent(studentId);
  if(!student) return;
  let record=(AppData.attendance||[]).find(r=>r.studentId===studentId&&r.date===formattedDate&&r.className===className);
  if(record){
    record.status=status;
    record.time=getCurrentTime();
  }else{
    AppData.attendance.push({
      id:'ATT'+String((AppData.attendance||[]).length+1).padStart(4,'0'),
      studentId:studentId,
      studentName:student.name,
      admissionNo:student.admissionNo,
      className:className,
      date:formattedDate,
      status:status,
      time:getCurrentTime(),
      parentPhone:student.contactNumber||student.guardianContact||''
    });
  }
  saveToStorage();
  loadAttendanceStudents();
  showToast(`✅ ${student.name} marked ${status}`,'success');
}

function saveAttendance(){
  saveToStorage();
  showToast('✅ Attendance saved successfully!','success');
  renderAttendance();
}

function sendWhatsAppAttendance(){
  const className=document.getElementById('attClass').value;
  const date=document.getElementById('attDate').value;
  if(!className){showToast('⚠️ Select a class first!','error');return;}
  const formattedDate=formatDate(date);
  const records=(AppData.attendance||[]).filter(r=>r.date===formattedDate&&r.className===className);
  if(records.length===0){showToast('⚠️ No attendance records for this date!','error');return;}
  const settings=AppData.schoolSettings||{};
  const schoolName=settings.schoolName||'SUBHANI ACADEMY SCHOOL';
  let message=`📋 *Attendance Report* - ${schoolName}\n📅 Date: ${formattedDate}\n📚 Class: ${className}\n\n`;
  records.forEach(r=>{
    const emoji=r.status==='Present'?'✅':r.status==='Absent'?'❌':'📋';
    message+=`${emoji} ${r.studentName}: ${r.status}\n`;
  });
  message+=`\n— ${schoolName}`;
  const phone=prompt('Enter WhatsApp number to send attendance report (e.g. 923001234567):');
  if(phone){
    const cleanPhone=phone.replace(/[^0-9]/g,'');
    const url=`https://wa.me/${cleanPhone}?text=${encodeURIComponent(message)}`;
    window.open(url,'_blank');
    showToast('📱 WhatsApp opened!','success');
  }
}

