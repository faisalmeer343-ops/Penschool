function saveInquiry(){
  const name=document.getElementById('inqName').value.trim();
  const father=document.getElementById('inqFather').value.trim();
  if(!name||!father){showToast('⚠️ Name and Father are required!','error');return;}
  const inquiry={
    id:'INQ'+String((AppData.inquiries||[]).length+1).padStart(4,'0'),
    name:name,
    fatherName:father,
    currentClass:document.getElementById('inqClass').value,
    subjects:document.getElementById('inqSubjects').value.trim(),
    fatherPhone:document.getElementById('inqFatherPhone').value.trim(),
    motherPhone:document.getElementById('inqMotherPhone').value.trim(),
    phone:document.getElementById('inqPersonalPhone').value.trim()||document.getElementById('inqFatherPhone').value.trim(),
    address:document.getElementById('inqAddress').value.trim(),
    fee:parseFloat(document.getElementById('inqFee').value)||0,
    inquiryDate:document.getElementById('inqDate').value,
    remarks:document.getElementById('inqRemarks').value.trim(),
    status:'Pending',
    createdAt:getTodayDateFormatted(),
    createdTime:getCurrentTime()
  };
  AppData.inquiries.push(inquiry);
  saveToStorage();
  renderInquiry();
  clearInquiryForm();
  showToast(`✅ Inquiry saved for ${name}!`,'success');
}

function clearInquiryForm(){
  ['inqName','inqFather','inqSubjects','inqFatherPhone','inqMotherPhone','inqPersonalPhone','inqAddress','inqRemarks'].forEach(id=>{
    const el=document.getElementById(id);if(el) el.value='';
  });
  document.getElementById('inqFee').value='0';
  document.getElementById('inqDate').value=getTodayDateInput();
  document.getElementById('inqClass').value=(AppData.schoolSettings.classes||[])[0]||'1st';
  showToast('🔄 Inquiry form cleared!','info');
}

function filterInquiries(){
  const search=document.getElementById('inqSearch').value.toLowerCase();
  const statusFilter=document.getElementById('inqStatusFilter').value;
  const tbody=document.getElementById('inquiryTableBody');
  let filtered=AppData.inquiries||[];
  if(search){filtered=filtered.filter(i=>i.name.toLowerCase().includes(search)||(i.fatherName||'').toLowerCase().includes(search)||(i.phone||'').includes(search));}
  if(statusFilter!=='All'){filtered=filtered.filter(i=>i.status===statusFilter);}
  if(filtered.length===0){
    tbody.innerHTML=`<tr><td colspan="8" style="padding:14px;color:var(--text-muted);text-align:center;">No inquiries found</td></tr>`;
    return;
  }
  tbody.innerHTML=filtered.slice().reverse().map(i=>{
    const statusClass=i.status==='Pending'?'badge-pending':i.status==='Admitted'?'badge-paid':'badge-inactive';
    return `<tr>
      <td>${i.inquiryDate?formatDate(i.inquiryDate):'N/A'}</td>
      <td><strong>${i.name}</strong></td>
      <td>${i.fatherName}</td>
      <td>${i.currentClass}</td>
      <td>${i.phone||'N/A'}</td>
      <td>${formatCurrency(i.fee||0)}</td>
      <td><span class="badge-status ${statusClass}">${i.status}</span></td>
      <td>
        <button class="btn btn-info btn-xs" onclick="printInquiryById('${i.id}')">🖨️</button>
        <button class="btn btn-success btn-xs" onclick="convertInquiryToAdmission('${i.id}')">✅ Admit</button>
        <button class="btn btn-danger btn-xs" onclick="deleteInquiry('${i.id}')">🗑️</button>
      </td>
    </tr>`;
  }).join('');
}

